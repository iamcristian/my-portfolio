    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.2",
    "daisyui": "^5.7.50",
    "giscus": "1.6.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "@fontsource-variable/inter": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
