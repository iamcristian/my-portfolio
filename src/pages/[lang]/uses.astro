---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Divider from "@components/ui/Divider.astro";
import { getLocaleStaticPaths } from "@config/paths";
import { useTranslations, getUsesForLang } from "@i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.locals;
const t = useTranslations(lang);
const usesCategories = getUsesForLang(lang);
---

<Layout
  title={t("uses.title")}
  description={t("uses.subtitlePage")}
  structuredDataType="collection"
>
  <Header />

  <main
    id="main-content"
    class="max-w-5xl mx-auto px-4 md:px-8 pt-8 md:pt-12 pb-16 md:pb-24 min-h-screen relative"
  >
    <!-- Back Button -->
    <div class="mb-6 md:mb-8">
      <a
        href={getRelativeLocaleUrl(lang, "")}
        class="btn btn-ghost btn-sm gap-2 border border-base-content/10 hover:border-base-content/30 rounded-full"
      >
        &larr; {t("uses.back") || "Back"}
      </a>
    </div>

    <!-- Kerr Spacetime Workstation Header Card (Monochromatic) -->
    <header
      data-spotlight="true"
      class="relative overflow-hidden rounded-2xl bg-base-200/45 backdrop-blur-md border border-base-content/10 p-6 md:p-10 mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
    >
      <div class="space-y-3 max-w-2xl relative z-10">
        <span class="text-xs font-mono font-semibold text-base-content/70 uppercase tracking-widest block">
          {t("uses.subtitle")}
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight bg-linear-to-r from-primary via-neutral-content to-secondary bg-clip-text text-transparent">
          {t("uses.title")}
        </h1>
        <p class="text-sm md:text-base opacity-80 leading-relaxed">
          {t("uses.subtitlePage")}
        </p>
      </div>

      <!-- Monochromatic Kerr Spacetime Ergosphere & Accretion Disk SVG Emblem -->
      <div class="hidden sm:flex items-center justify-center shrink-0 relative w-36 h-36">
        <div
          class="absolute inset-0 rounded-full blur-2xl opacity-25 pointer-events-none bg-base-content/15"
          aria-hidden="true"
        ></div>
        <svg
          class="w-full h-full text-base-content kerr-ergosphere-svg"
          viewBox="0 0 140 140"
          fill="none"
          aria-hidden="true"
        >
          <!-- Outer Ergosphere Contours -->
          <ellipse
            cx="70"
            cy="70"
            rx="62"
            ry="26"
            transform="rotate(-18 70 70)"
            stroke="currentColor"
            stroke-width="0.6"
            stroke-dasharray="3 3"
            class="opacity-35"
          ></ellipse>
          <ellipse
            cx="70"
            cy="70"
            rx="48"
            ry="20"
            transform="rotate(-18 70 70)"
            stroke="currentColor"
            stroke-width="0.75"
            class="opacity-55"
          ></ellipse>
          <circle
            cx="70"
            cy="70"
            r="38"
            stroke="currentColor"
            stroke-width="0.4"
            stroke-dasharray="2 4"
            class="opacity-25 kerr-orbit-ring"
          ></circle>
          <!-- Event Horizon Core -->
          <circle
            cx="70"
            cy="70"
            r="14"
            fill="#090d16"
            stroke="currentColor"
            stroke-width="1"
            class="opacity-85"
          ></circle>
          <!-- Photon Ring Satellites (Monochromatic Starlight) -->
          <circle
            cx="98"
            cy="60"
            r="1.8"
            fill="currentColor"
            class="opacity-85"
          ></circle>
          <circle
            cx="32"
            cy="82"
            r="1.5"
            fill="currentColor"
            class="opacity-65"
          ></circle>
        </svg>
      </div>
    </header>

    <Divider />

    <!-- Gear Categories List -->
    <div class="space-y-14 mt-4">
      {usesCategories.map((category) => (
        <section class="space-y-6 scroll-reveal">
          <div class="flex items-center gap-3 border-b border-base-content/10 pb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-base-content/70 shrink-0"></span>
            <h2 class="text-lg md:text-2xl font-bold text-base-content tracking-tight">
              {category.name}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {category.items.map((item) => (
              <div
                data-spotlight="true"
                class="card relative overflow-hidden bg-base-200/55 backdrop-blur-md border border-base-content/10 p-6 hover:border-base-content/30 hover:-translate-y-1 transition-all duration-300 group rounded-2xl"
              >
                <!-- Subtle Monochromatic Orbital Arc Watermark -->
                <svg
                  class="absolute -bottom-4 -right-4 w-24 h-24 text-base-content opacity-10 group-hover:opacity-30 transition-opacity duration-500 pointer-events-none select-none"
                  viewBox="0 0 80 80"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="60"
                    cy="60"
                    r="32"
                    stroke="currentColor"
                    stroke-width="0.6"
                    stroke-dasharray="2 3"
                  ></circle>
                  <circle cx="28" cy="60" r="1.5" fill="currentColor"></circle>
                </svg>

                <h3 class="font-bold text-sm md:text-base group-hover:text-primary transition-colors relative z-10 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-base-content/60 shrink-0"></span>
                  {item.link ? (
                    <a href={item.link} class="link link-hover">
                      {item.name}
                    </a>
                  ) : (
                    <span>{item.name}</span>
                  )}
                </h3>
                <p class="text-xs md:text-sm opacity-80 leading-relaxed mt-2.5 relative z-10">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes kerr-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .kerr-orbit-ring {
    transform-origin: 70px 70px;
    animation: kerr-spin 18s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .kerr-orbit-ring {
      animation: none !important;
    }
  }
</style>
