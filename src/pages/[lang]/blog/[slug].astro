---
import BlogLayout from "@layouts/BlogLayout.astro";
import BlogPostDetail from "@components/blog/BlogPostDetail.astro";
import { getCollection } from "astro:content";
import { getWordCount, isPublished } from "@utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const routes = new Set<string>();
  for (const post of posts) {
    const route = `${post.data.lang}/${post.data.slug}`;
    if (routes.has(route)) throw new Error(`Duplicate blog route: ${route}`);
    if (post.id !== route)
      throw new Error(
        `Blog filename must match locale/slug: ${post.id} != ${route}`,
      );
    routes.add(route);
  }
  // Only real translations receive URLs, canonical tags and sitemap entries.
  return posts
    .filter((post) => isPublished(post.data))
    .map((post) => ({
      params: { lang: post.data.lang, slug: post.data.slug },
      props: { post },
    }));
}
const { post } = Astro.props;
---

<BlogLayout post={post} wordCount={getWordCount(post.body, post.data.lang)}>
  <BlogPostDetail post={post} />
</BlogLayout>
