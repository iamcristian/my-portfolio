---
import { getCollection } from "astro:content";
import { isPublished } from "@utils/blog";
import Globe from "../assets/icons/globe.svg";
import Check from "../assets/icons/check.svg";
import { languages } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const { lang: currentLang } = Astro.locals;
const t = useTranslations(currentLang);

const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean);

const translatedLocales = Astro.params.slug
  ? (
      await getCollection(
        "blog",
        (post) =>
          post.data.slug === Astro.params.slug && isPublished(post.data),
      )
    ).map((post) => post.data.lang)
  : null;

function getPathForLocale(targetLang: string) {
  if (
    translatedLocales &&
    !translatedLocales.some((lang) => lang === targetLang)
  )
    return `/${targetLang}/blog/`;
  const hasLocalePrefix = Object.keys(languages).includes(segments[0]);
  const restSegments = hasLocalePrefix ? segments.slice(1) : segments;
  const joined = restSegments.join("/");
  const path = `/${targetLang}/${joined}${joined ? "/" : ""}`;
  return path.replace(/\/+/g, "/");
}
---

<details title={t("language.title")} class="dropdown dropdown-end">
  <summary
    class="language-trigger inline-flex h-10 items-center justify-center gap-1.5 px-2 opacity-70 hover:opacity-100 transition-opacity duration-200 cursor-pointer list-none rounded-lg"
    aria-label={t("language.title")}
  >
    <Globe
      aria-hidden="true"
      class="block text-base-content/70 size-4 shrink-0"
    />
    <span class="block text-xs leading-none font-medium">
      {currentLang.toUpperCase()}
    </span>
  </summary>
  <div class="dropdown-content bg-base-200 text-base-content rounded-box mt-3 max-h-[calc(100vh-10rem)] overflow-y-auto overflow-x-hidden border border-base-content/10 shadow-2xl z-50 w-44">
    <ul class="menu menu-sm">
      <li class="menu-title text-xs whitespace-nowrap">
        {t("language.title")}
      </li>
      {Object.entries(languages).map(([code, { name }]) => {
        const active = code === currentLang;
        return (
          <li>
            <a
              href={getPathForLocale(code)}
              lang={code}
              hreflang={code}
              class:list={["flex items-center gap-3 px-2 w-full", { active }]}
            >
              <div class="bg-base-100 flex items-center justify-center rounded-md border border-base-content/10 shadow-sm size-6 shrink-0 text-xs font-bold font-mono opacity-75">
                {code.toUpperCase()}
              </div>
              <span class="text-left font-normal"> {name}</span>
              {active && <Check class="size-3 shrink-0 ml-auto" />}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</details>

<style>
  .language-trigger::-webkit-details-marker {
    display: none;
  }
</style>
