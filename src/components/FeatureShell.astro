---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { featureCopy } from "../i18n/features";

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title,
  description = title,
  image,
  imageAlt,
  type = "website",
} = Astro.props;
const { lang } = Astro.locals;
const c = featureCopy(lang);
const links = [
  { path: "search", label: c.search },
  { path: "library", label: c.library },
  { path: "series", label: c.series },
  { path: "bookshelf", label: c.bookshelf },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type={type}
>
  <Header />
  <main
    id="main-content"
    class="max-w-6xl mx-auto px-4 md:px-8 py-12 min-h-screen space-y-8 relative"
  >
    <header class="space-y-3">
      <span class="font-mono text-xs uppercase tracking-widest text-base-content/70 font-semibold block">
        // {c.evidence}
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight bg-linear-to-r from-primary via-neutral-content to-secondary bg-clip-text text-transparent">
        {title}
      </h1>
    </header>

    <nav
      class="flex flex-wrap gap-x-6 gap-y-1 border-b border-base-content/15 bg-base-200/35 backdrop-blur-md px-4 rounded-t-xl"
      aria-label={c.evidence}
    >
      {links.map((link) =>
        currentPath === "/" + lang + "/" + link.path ? (
          <span
            aria-current="page"
            class="inline-flex items-center gap-1.5 min-h-11 border-b-2 border-base-content/80 text-sm font-semibold text-base-content"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-base-content/80"></span>
            {link.label}
          </span>
        ) : (
          <a
            data-astro-reload
            href={"/" + lang + "/" + link.path + "/"}
            class="inline-flex items-center min-h-11 border-b-2 border-transparent text-sm opacity-70 hover:opacity-100 hover:text-primary transition-colors"
          >
            {link.label}
          </a>
        ),
      )}
    </nav>
    <slot />
  </main>
  <Footer />
</Layout>
