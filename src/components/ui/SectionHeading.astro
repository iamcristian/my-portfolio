---
interface Props {
  subtitle: string;
  title: string;
  centered?: boolean;
}

const { subtitle, title, centered = true } = Astro.props;
---

<div data-reveal class:list={[centered && "text-center", "mb-12 relative"]}>
  <div
    class:list={[
      "inline-flex items-center gap-2 mb-2.5 px-3 py-1 rounded-full bg-base-200/50 border border-base-content/10 backdrop-blur-sm",
      centered && "justify-center",
    ]}
  >
    <svg
      class="w-3 h-3 text-amber-400 animate-spin"
      style="animation-duration: 14s;"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
    </svg>
    <span class="font-mono text-xs tracking-widest uppercase text-primary font-semibold block">
      {subtitle}
    </span>
  </div>

  <h2 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-base-content">
    {title}
  </h2>

  <!-- Celestial Eclipse & Orbital Horizon Underline -->
  <div
    class:list={[
      "flex items-center gap-2 mt-3.5",
      centered ? "justify-center" : "justify-start",
    ]}
    aria-hidden="true"
  >
    <span class="w-12 h-px bg-gradient-to-r from-transparent via-primary/40 to-primary/80"></span>
    <span class="w-1 h-1 rounded-full bg-sky-400/80"></span>
    <svg
      class="w-3.5 h-3.5 text-amber-400 drop-shadow-[0_0_6px_rgba(251,191,36,0.7)]"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
    </svg>
    <span class="w-1 h-1 rounded-full bg-violet-400/80"></span>
    <span class="w-12 h-px bg-gradient-to-l from-transparent via-primary/40 to-primary/80"></span>
  </div>
</div>
