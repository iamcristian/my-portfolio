---
interface Props {
  subtitle: string;
  title: string;
  centered?: boolean;
}

const { subtitle, title, centered = true } = Astro.props;
---

<div data-reveal class:list={[centered && "text-center", "mb-12"]}>
  <div
    class:list={[
      "inline-flex items-center gap-2 mb-2.5",
      centered && "justify-center",
    ]}
  >
    <span class="w-1.5 h-1.5 rounded-full bg-primary/80 animate-pulse"></span>
    <span class="font-mono text-xs tracking-widest uppercase text-primary font-semibold block">
      {subtitle}
    </span>
  </div>
  <h2 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-base-content">
    {title}
  </h2>
  <div
    class:list={[
      "w-12 h-1 bg-gradient-to-r from-primary to-accent mt-3 rounded-full shadow-[0_0_10px_color-mix(in_oklch,var(--color-primary)_40%,transparent)]",
      centered && "mx-auto",
    ]}
  ></div>
</div>
