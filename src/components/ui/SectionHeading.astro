---
interface Props {
  subtitle: string;
  title: string;
  centered?: boolean;
}

const { subtitle, title, centered = true } = Astro.props;
---

<div class:list={[centered && "text-center", "mb-12 relative"]}>
  <span class="font-mono text-xs tracking-widest uppercase text-base-content/70 font-semibold mb-2 block">
    {subtitle}
  </span>

  <h2 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-base-content">
    {title}
  </h2>

  <!-- Minimalist Monochromatic Celestial Horizon Underline -->
  <div
    class:list={[
      "flex items-center gap-2.5 mt-3.5",
      centered ? "justify-center" : "justify-start",
    ]}
    aria-hidden="true"
  >
    <span class="w-12 h-px bg-linear-to-r from-transparent via-base-content/20 to-base-content/50"></span>
    <span class="w-1 h-1 rounded-full bg-base-content/70 shadow-[0_0_6px_rgba(255,255,255,0.4)]"></span>
    <span class="w-12 h-px bg-linear-to-l from-transparent via-base-content/20 to-base-content/50"></span>
  </div>
</div>
