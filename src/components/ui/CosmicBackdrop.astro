        y2="60"
      >
        <stop
          offset="0%"
          stop-color="var(--quasar-accent)"
          stop-opacity="0.2"
        />
        <stop
          offset="55%"
          stop-color="var(--quasar-tint)"
          stop-opacity="0.48"
        />
        <stop
          offset="100%"
          stop-color="var(--quasar-tint)"
          stop-opacity="0.86"
        />
      </linearGradient>

      <linearGradient
        id="quasar-beta-jet-near"
