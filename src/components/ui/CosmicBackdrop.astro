          stroke-width="0.6"
          stroke-linecap="round"
        />
      </g>

      <ellipse
        cx="60"
        cy="60"
        rx="29"
        ry="8.8"
        stroke="url(#quasar-beta-disk-rim)"
        stroke-width="0.5"
