---
// Continuous Deep-Space Universe Backdrop for the entire portfolio
// Uses a lightweight static SVG starfield instead of 127 CSS box-shadows or scroll-linked transforms
// so mobile GPUs rasterize tiles instantly during fast touch scrolling with zero checkerboarding.

const createPrng = (seed: number) => {
  let s = seed | 0;
  return () => {
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

interface Star {
  x: string;
  y: string;
  r: string;
  opacity: string;
}

const generateStars = (
  count: number,
  seed: number,
  minR: number,
  maxR: number,
): Star[] => {
  const prng = createPrng(seed);
  const stars: Star[] = [];
  for (let i = 0; i < count; i++) {
    const x = (prng() * 98 + 1).toFixed(2);
    const y = (prng() * 98 + 1).toFixed(2);
    const r = (minR + prng() * (maxR - minR)).toFixed(2);
    const opacity = (0.3 + prng() * 0.55).toFixed(2);
    stars.push({ x, y, r, opacity });
  }
  return stars;
};

const starsLayer1 = generateStars(45, 4096, 0.5, 0.85);
const starsLayer2 = generateStars(25, 8192, 0.85, 1.25);
---

<div
  class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none cosmic-global-backdrop"
  aria-hidden="true"
>
  <!-- Pure Radial Gradient Deep-Space Dust Clouds (No expensive filter: blur() pass) -->
  <div
    class="absolute -top-24 -left-24 w-[36rem] h-[36rem] rounded-full opacity-20"
    style="background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, rgba(148, 163, 184, 0.03) 45%, transparent 70%);"
  ></div>
  <div
    class="absolute top-1/3 -right-32 w-[40rem] h-[40rem] rounded-full opacity-15"
    style="background: radial-gradient(circle, rgba(226, 232, 240, 0.07) 0%, rgba(148, 163, 184, 0.025) 45%, transparent 70%);"
  ></div>
  <div
    class="absolute -bottom-32 left-1/4 w-[38rem] h-[38rem] rounded-full opacity-15"
    style="background: radial-gradient(circle, rgba(255, 255, 255, 0.07) 0%, rgba(148, 163, 184, 0.03) 45%, transparent 70%);"
  ></div>

  <!-- Single Composite SVG Starfield (Zero box-shadow repaints, instant GPU tile rasterization) -->
  <svg
    class="absolute inset-0 w-full h-full text-white"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    <g>
      {starsLayer1.map((s) => (
        <circle
          cx={Number(s.x) * 10}
          cy={Number(s.y) * 10}
          r={s.r}
          fill="currentColor"
          opacity={s.opacity}
        />
      ))}
    </g>
    <g class="cosmic-stars-twinkle">
      {starsLayer2.map((s) => (
        <circle
          cx={Number(s.x) * 10}
          cy={Number(s.y) * 10}
          r={s.r}
          fill="currentColor"
          opacity={s.opacity}
        />
      ))}
    </g>
  </svg>

  <!-- Signature 4-Point Monochromatic Celestial Stars -->
  <svg
    class="cosmic-diamond-star top-[18%] left-[8%] w-2.5 h-2.5 text-white/55"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
  </svg>
  <svg
    class="cosmic-diamond-star top-[46%] right-[9%] w-2.5 h-2.5 text-white/50"
    style="animation-delay: 2.2s;"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
  </svg>
  <svg
    class="cosmic-diamond-star top-[78%] left-[14%] w-2 h-2 text-white/45"
    style="animation-delay: 4.1s;"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
  </svg>
  <svg
    class="cosmic-diamond-star top-[64%] right-[18%] w-2 h-2 text-white/45"
    style="animation-delay: 1.4s;"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
  </svg>

  <!-- Ambient Deep-Space Comets (Desktop only to preserve mobile GPU budget) -->
  <div class="hidden md:block cosmic-comet cosmic-comet-1">
    <div class="cosmic-comet-body">
      <span class="cosmic-comet-core"></span>
      <span class="cosmic-comet-tail"></span>
    </div>
  </div>
  <div class="hidden md:block cosmic-comet cosmic-comet-2">
    <div class="cosmic-comet-body">
      <span class="cosmic-comet-core"></span>
      <span class="cosmic-comet-tail"></span>
    </div>
  </div>
</div>

<style>
  .cosmic-diamond-star {
    position: absolute;
    pointer-events: none;
    animation: diamond-pulse 7s ease-in-out infinite;
  }

  @keyframes diamond-pulse {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.85);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.15);
    }
  }

  :global([data-theme="light"]) .cosmic-global-backdrop {
    opacity: 0.35;
    filter: invert(0.85);
  }

  .cosmic-stars-twinkle {
    animation: cosmic-twinkle 8s ease-in-out infinite;
  }

  @keyframes cosmic-twinkle {
    0%,
    100% {
      opacity: 0.9;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Deep Space Comets */
  .cosmic-comet {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }
  .cosmic-comet-body {
    display: flex;
    align-items: center;
  }
  .cosmic-comet-core {
    width: 2.5px;
    height: 2.5px;
    background: #fff;
    border-radius: 9999px;
    box-shadow:
      0 0 6px #fff,
      0 0 12px rgba(255, 255, 255, 0.7);
  }
  .cosmic-comet-tail {
    width: 110px;
    height: 1.25px;
    background: linear-gradient(
      to left,
      transparent,
      rgba(255, 255, 255, 0.45),
      #ffffff
    );
    border-radius: 9999px;
  }

  .cosmic-comet-1 {
    top: 32%;
    right: 15%;
    animation: comet-streak 14s cubic-bezier(0.25, 0.1, 0.25, 1) infinite 2s;
  }
  .cosmic-comet-2 {
    top: 68%;
    right: 35%;
    animation: comet-streak 19s cubic-bezier(0.25, 0.1, 0.25, 1) infinite 8s;
  }

  @keyframes comet-streak {
    0% {
      transform: translate3d(160px, -160px, 0) rotate(-45deg) scale(0.3);
      opacity: 0;
    }
    5% {
      opacity: 0.9;
      transform: translate3d(60px, -60px, 0) rotate(-45deg) scale(1);
    }
    14% {
      transform: translate3d(-220px, 220px, 0) rotate(-45deg) scale(0.4);
      opacity: 0;
    }
    100% {
      transform: translate3d(-220px, 220px, 0) rotate(-45deg) scale(0);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmic-stars-twinkle,
    .cosmic-diamond-star,
    .cosmic-comet {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
