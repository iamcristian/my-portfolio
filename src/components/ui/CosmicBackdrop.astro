    <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
  </svg>

  <!-- Deep-Space Active Galactic Nuclei / Quasars (Pure SVG + native gradients, zero blur passes) -->
