  <!-- Ambient Deep-Space Comets (Desktop only to preserve mobile GPU budget) -->
  <div class="hidden md:block cosmic-comet cosmic-comet-1">
    <div class="cosmic-comet-body">
      <span class="cosmic-comet-core"></span>
      <span class="cosmic-comet-tail"></span>
    </div>
  </div>
  <div class="hidden md:block cosmic-comet cosmic-comet-2">
    <div class="cosmic-comet-body">
      <span class="cosmic-comet-core"></span>
      <span class="cosmic-comet-tail"></span>
    </div>
  </div>
</div>

<style>
  .cosmic-diamond-star {
    position: absolute;
    pointer-events: none;
    animation: diamond-pulse 7s ease-in-out infinite;
  }

  @keyframes diamond-pulse {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.85);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.15);
    }
  }

  .cosmic-global-backdrop {
    --quasar-tint: color-mix(in oklch, var(--color-primary) 35%, #ffffff);
    --quasar-accent: color-mix(in oklch, var(--color-accent) 30%, #ffffff);
  }

  :global([data-theme="light"]) .cosmic-global-backdrop {
    opacity: 0.35;
    filter: invert(0.85);
    --quasar-tint: #ffffff;
    --quasar-accent: #cbd5e1;
  }

  /* Deep-Space Active Galactic Nuclei / Quasars */
  .cosmic-quasar {
    position: absolute;
    pointer-events: none;
    backface-visibility: hidden;
  }

  .cosmic-quasar-alpha {
    opacity: 0.42;
  }

  .cosmic-quasar-beta {
    opacity: 0.28;
  }

  .quasar-jet-pulse {
    animation: quasar-jet-breathe 11s ease-in-out infinite;
  }

  .quasar-core-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: quasar-core-shimmer 6.5s ease-in-out infinite;
  }

  @keyframes quasar-jet-breathe {
    0%,
    100% {
      opacity: 0.68;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes quasar-core-shimmer {
    0%,
    100% {
      opacity: 0.82;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  .cosmic-stars-twinkle {
    animation: cosmic-twinkle 8s ease-in-out infinite;
  }

  @keyframes cosmic-twinkle {
    0%,
    100% {
      opacity: 0.9;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Deep Space Comets */
  .cosmic-comet {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }
  .cosmic-comet-body {
    display: flex;
    align-items: center;
  }
  .cosmic-comet-core {
    width: 2.5px;
    height: 2.5px;
    background: #fff;
    border-radius: 9999px;
    box-shadow:
      0 0 6px #fff,
      0 0 12px rgba(255, 255, 255, 0.7);
  }
  .cosmic-comet-tail {
    width: 110px;
    height: 1.25px;
    background: linear-gradient(
      to left,
      transparent,
      rgba(255, 255, 255, 0.45),
      #ffffff
    );
    border-radius: 9999px;
  }

  .cosmic-comet-1 {
    top: 32%;
    right: 15%;
    animation: comet-streak 14s cubic-bezier(0.25, 0.1, 0.25, 1) infinite 2s;
  }
  .cosmic-comet-2 {
    top: 68%;
    right: 35%;
    animation: comet-streak 19s cubic-bezier(0.25, 0.1, 0.25, 1) infinite 8s;
  }

  @keyframes comet-streak {
    0% {
      transform: translate3d(160px, -160px, 0) rotate(-45deg) scale(0.3);
      opacity: 0;
    }
    5% {
      opacity: 0.9;
      transform: translate3d(60px, -60px, 0) rotate(-45deg) scale(1);
    }
