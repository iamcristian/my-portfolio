      <!-- Hyper-luminous AGN Core & 4-Point Diffraction Spike -->
      <g class="quasar-core-pulse">
        <circle cx="80" cy="80" r="14" fill="url(#quasar-alpha-core)" />
        <path
          d="M80 68 C80 78.4 80 78.4 92 80 C80 81.6 80 81.6 80 92 C80 81.6 80 81.6 68 80 C80 78.4 80 78.4 80 68 Z"
          fill="#ffffff"
          opacity="0.88"
        />
        <circle cx="80" cy="80" r="1.8" fill="#ffffff" />
      </g>
    </g>
  </svg>

  <!-- Quasar Beta: Distant High-Redshift Micro-Quasar (Lower-right peripheral field, +24deg disk / -66deg jet axis) -->
  <svg
    class="hidden sm:block cosmic-quasar cosmic-quasar-beta top-[75%] right-[3.5%] lg:right-[5.5%] w-16 h-16 md:w-24 md:h-24"
    viewBox="0 0 120 120"
    fill="none"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id="quasar-beta-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--quasar-tint)" stop-opacity="0.22" />
        <stop
          offset="38%"
          stop-color="var(--quasar-accent)"
          stop-opacity="0.08"
        />
        <stop
          offset="100%"
          stop-color="var(--quasar-accent)"
          stop-opacity="0"
        />
      </radialGradient>

      <linearGradient
        id="quasar-beta-disk-fill"
        gradientUnits="userSpaceOnUse"
        x1="39"
        y1="60"
        x2="81"
        y2="60"
      >
        <stop
          offset="0%"
          stop-color="var(--quasar-accent)"
          stop-opacity="0.08"
        />
        <stop
          offset="55%"
          stop-color="var(--quasar-accent)"
          stop-opacity="0.16"
        />
        <stop
          offset="100%"
          stop-color="var(--quasar-tint)"
          stop-opacity="0.32"
        />
      </linearGradient>

      <linearGradient
        id="quasar-beta-disk-rim"
        gradientUnits="userSpaceOnUse"
        x1="30"
