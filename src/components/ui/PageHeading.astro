---
interface Props {
  subtitle: string;
  title: string;
  description?: string;
}

const { subtitle, title, description } = Astro.props;
---

<div class="text-center space-y-4 max-w-2xl mx-auto relative py-4">
  <!-- Ambient Starlight Glow behind Page Title -->
  <div
    class="absolute inset-x-1/4 -top-6 h-28 rounded-full bg-base-content/5 blur-3xl pointer-events-none -z-10"
    aria-hidden="true"
  ></div>

  <!-- Monochromatic Celestial Orbital Arc SVG -->
  <svg
    class="w-64 h-7 mx-auto text-base-content pointer-events-none select-none opacity-45 -mb-2"
    viewBox="0 0 240 28"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M 10 24 Q 120 2 230 24"
      stroke="currentColor"
      stroke-width="0.6"
      stroke-dasharray="2 3"
      class="opacity-45"
    ></path>
    <circle
      cx="65"
      cy="15"
      r="1.2"
      fill="currentColor"
      class="opacity-55"
    ></circle>
    <circle
      cx="120"
      cy="13"
      r="1.6"
      fill="currentColor"
      class="opacity-85"
    ></circle>
    <circle
      cx="175"
      cy="15"
      r="1.2"
      fill="currentColor"
      class="opacity-55"
    ></circle>
  </svg>

  <span class="font-mono text-xs tracking-widest uppercase text-base-content/70 font-semibold block">
    <span aria-hidden="true">//</span> {subtitle.replace(/^\/\/\s*/, "")}
  </span>

  <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight bg-linear-to-r from-primary via-neutral-content to-secondary bg-clip-text text-transparent pb-2">
    {title}
  </h1>

  {description && (
    <p class="text-sm md:text-base opacity-80 leading-relaxed">{description}</p>
  )}

  <!-- Monochromatic Horizon Underline -->
  <div class="flex items-center justify-center gap-2.5 pt-1" aria-hidden="true">
    <span class="w-16 h-px bg-linear-to-r from-transparent via-base-content/20 to-base-content/50"></span>
    <span class="w-1 h-1 rounded-full bg-base-content/75 shadow-[0_0_6px_rgba(255,255,255,0.4)]"></span>
    <span class="w-16 h-px bg-linear-to-l from-transparent via-base-content/20 to-base-content/50"></span>
  </div>
</div>
