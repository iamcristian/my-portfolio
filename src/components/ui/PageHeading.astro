---
interface Props {
  subtitle: string;
  title: string;
  description?: string;
}

const { subtitle, title, description } = Astro.props;
---

<div class="text-center space-y-4 max-w-2xl mx-auto relative py-4">
  <!-- Ambient Nebula Glow behind Page Title -->
  <div
    class="absolute inset-x-1/4 -top-6 h-28 rounded-full bg-primary/8 blur-3xl pointer-events-none -z-10"
    aria-hidden="true"
  ></div>

  <!-- Celestial Orbital Arc SVG -->
  <svg
    class="w-64 h-7 mx-auto text-base-content pointer-events-none select-none opacity-65 -mb-2"
    viewBox="0 0 240 28"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M 10 24 Q 120 2 230 24"
      stroke="currentColor"
      stroke-width="0.6"
      stroke-dasharray="2 3"
      class="opacity-35"
    ></path>
    <circle cx="65" cy="15" r="1.5" fill="#60a5fa" class="opacity-80"></circle>
    <circle cx="175" cy="15" r="1.5" fill="#a78bfa" class="opacity-80"></circle>
    <path
      d="M120 7 C120 11 120 11 124 13 C120 13 120 15 120 19 C120 15 120 15 116 13 C120 13 120 11 120 7 Z"
      fill="#fbbf24"
    ></path>
  </svg>

  <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-base-200/60 border border-base-content/10 backdrop-blur-md">
    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
    <span class="font-mono text-xs tracking-widest uppercase text-primary font-semibold block">
      <span aria-hidden="true">//</span> {subtitle.replace(/^\/\/\s*/, "")}
    </span>
  </div>

  <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight bg-linear-to-r from-primary via-neutral-content to-secondary bg-clip-text text-transparent pb-2">
    {title}
  </h1>

  {description && (
    <p class="text-sm md:text-base opacity-80 leading-relaxed">{description}</p>
  )}

  <!-- Celestial Horizon Underline -->
  <div class="flex items-center justify-center gap-2 pt-1" aria-hidden="true">
    <span class="w-16 h-px bg-gradient-to-r from-transparent via-primary/35 to-primary/75"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-amber-400/90 shadow-[0_0_8px_#fbbf24]"></span>
    <span class="w-16 h-px bg-gradient-to-l from-transparent via-primary/35 to-primary/75"></span>
  </div>
</div>
