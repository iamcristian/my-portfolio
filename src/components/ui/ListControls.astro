---
import { useTranslations } from "../../i18n/utils";
import SearchIcon from "../../assets/icons/search.svg";
import GridIcon from "../../assets/icons/grid.svg";
import ListIcon from "../../assets/icons/list.svg";
import SortIcon from "../../assets/icons/sort.svg";

interface Props {
  searchInputId: string;
  searchPlaceholder: string;
  dateRangeSelectId: string;
  customDateContainerId: string;
  startDateInputId: string;
  endDateInputId: string;
  dateErrorId: string;
  sortSelectId: string;
}

const {
  searchInputId,
  searchPlaceholder,
  dateRangeSelectId,
  customDateContainerId,
  startDateInputId,
  endDateInputId,
  dateErrorId,
  sortSelectId,
} = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);
---

<div class="flex flex-col gap-6 bg-base-200 p-6 rounded-2xl border border-base-300">
  <!-- Top Row: Search + View Toggle -->
  <div class="flex flex-col sm:flex-row gap-4 justify-between items-center">
    <div class="relative w-full sm:max-w-md">
      <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none opacity-60">
        <SearchIcon class="w-5 h-5" />
      </span>
      <input
        type="search"
        id={searchInputId}
        aria-label={searchPlaceholder}
        class="input input-bordered w-full pl-10 bg-base-100"
        placeholder={searchPlaceholder}
      />
    </div>

    <div class="join shrink-0">
      <button
        type="button"
        id="view-grid-btn"
        class="btn join-item btn-active btn-square"
        aria-label={t("projects.viewGrid")}
      >
        <GridIcon class="w-5 h-5" />
      </button>
      <button
        type="button"
        id="view-list-btn"
        class="btn join-item btn-square"
        aria-label={t("projects.viewList")}
      >
        <ListIcon class="w-5 h-5" />
      </button>
    </div>
  </div>

  <!-- Bottom Row: Filter Slot + Date & Sort Controls -->
  <div class="flex flex-col md:flex-row gap-4 justify-between items-start md:items-center border-t border-base-300 pt-4">
    <slot name="filters" />

    <div class="flex flex-col items-center md:items-end gap-1.5 w-full md:w-auto">
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-3 w-full md:w-auto">
        <div class="flex items-center gap-2">
          <span class="text-xs text-base-content/80 font-semibold whitespace-nowrap uppercase tracking-wider">
            {t("blog.filterDateRange")}
          </span>
          <select
            id={dateRangeSelectId}
            aria-label={t("blog.filterDateRange")}
            class="select select-bordered select-sm bg-base-100 font-medium text-xs focus:ring-2 focus:ring-primary focus:outline-none"
          >
            <option value="all" selected>
              {t("blog.dateAll")}
            </option>
            <option value="yesterday">{t("blog.dateYesterday")}</option>
            <option value="week">{t("blog.dateWeek")}</option>
            <option value="month">{t("blog.dateMonth")}</option>
            <option value="year">{t("blog.dateYear")}</option>
            <option value="custom">{t("blog.dateCustom")}</option>
          </select>
        </div>

        <div
          id={customDateContainerId}
          class="hidden items-center gap-1 bg-base-100 border border-base-300 rounded-lg p-1 transition-all duration-300"
        >
          <input
            type="date"
            id={startDateInputId}
            class="input input-ghost input-xs bg-transparent w-28 text-xs px-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
            aria-label={t("blog.startDate")}
          />
          <span class="opacity-40 text-xs px-0.5">-</span>
          <input
            type="date"
            id={endDateInputId}
            class="input input-ghost input-xs bg-transparent w-28 text-xs px-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
            aria-label={t("blog.endDate")}
          />
        </div>

        <div class="flex items-center gap-2">
          <SortIcon class="w-4 h-4 opacity-80 shrink-0" />
          <select
            id={sortSelectId}
            aria-label={t("accessibility.sort")}
            class="select select-bordered select-sm bg-base-100 font-medium text-xs focus:ring-2 focus:ring-primary focus:outline-none"
          >
            <option value="relevance" selected>
              {t("blog.sortRelevance")}
            </option>
            <option value="date-desc">{t("projects.sortDateNewest")}</option>
            <option value="date-asc">{t("projects.sortDateOldest")}</option>
          </select>
        </div>
      </div>
      <p id={dateErrorId} class="hidden text-xs text-error" role="alert">
        {t("blog.invalidDateRange")}
      </p>
    </div>
  </div>
</div>
