---
import { Image } from "astro:assets";

interface Props {
  item: {
    logo: string;
    name: string;
    description: string;
  };
}

const { item } = Astro.props;

// Dynamically resolve optimized language flag from src/assets/images/languages/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/languages/*.{jpeg,jpg,png,gif,webp}",
);
const imageImport = images[item.logo]!;
---

<div
  data-spotlight="true"
  class="group relative overflow-hidden card bg-base-200/55 backdrop-blur-md border border-base-content/10 hover:border-base-content/30 p-6 text-center items-center transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.35)] rounded-2xl"
>
  <!-- Flag container with rotating monochromatic planetary orbit ring -->
  <div class="relative w-20 h-20 mb-4 flex items-center justify-center shrink-0">
    <svg
      class="absolute inset-0 w-full h-full text-base-content opacity-25 group-hover:opacity-65 pointer-events-none lang-orbit-svg"
      viewBox="0 0 80 80"
      fill="none"
      aria-hidden="true"
    >
      <circle
        cx="40"
        cy="40"
        r="37"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="2 3"
      ></circle>
      <circle cx="40" cy="3" r="1.8" fill="currentColor"></circle>
      <circle
        cx="77"
        cy="40"
        r="1.4"
        fill="currentColor"
        class="opacity-70"
      ></circle>
    </svg>
    <div class="relative w-14 h-14 rounded-full p-0.5 bg-linear-to-tr from-primary to-secondary group-hover:scale-105 transition-transform duration-300 shrink-0">
      <div class="w-full h-full rounded-full overflow-hidden border-2 border-base-200 shrink-0">
        <Image
          src={imageImport()}
          alt={item.name}
          width={48}
          height={32}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>

  <h3 class="font-bold text-sm md:text-base group-hover:text-primary transition-colors relative z-10">
    {item.name}
  </h3>
  <span class="badge badge-xs font-mono bg-base-300/60 border border-base-content/10 text-base-content/85 mt-1.5 px-3 py-2 relative z-10">
    {item.description}
  </span>
</div>

<style>
  @keyframes lang-orbit-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .lang-orbit-svg {
    animation: lang-orbit-spin 22s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-orbit-svg {
      animation: none !important;
    }
  }
</style>
