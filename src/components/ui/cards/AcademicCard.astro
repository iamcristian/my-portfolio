---
import type { AcademicItem } from "../../../types";
import { useTranslations } from "../../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import LinkIcon from "../../../assets/icons/link.svg";

interface Props {
  item: AcademicItem;
}

const { item } = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);

// Dynamically resolve optimized certificate image from src/assets/images/certs/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/certs/*.{jpeg,jpg,png,gif,webp}",
);
const imageImport = images[item.logo]!;

const getLinkUrl = (url: string) => {
  if (url.startsWith("http://") || url.startsWith("https://")) {
    return url;
  }
  return getRelativeLocaleUrl(lang, url);
};
---

<div
  data-spotlight="true"
  class="group relative overflow-hidden card card-side bg-base-200/90 md:bg-base-200/55 md:backdrop-blur-md border border-base-content/10 p-5 flex gap-4 items-start hover:-translate-y-1 hover:border-base-content/30 hover:shadow-[0_15px_35px_-12px_rgba(0,0,0,0.35)] transition-all duration-300 rounded-xl"
>
  <!-- Subtle Monochromatic Celestial Astrolabe Watermark SVG -->
  <svg
    class="absolute -top-6 -right-6 w-28 h-28 text-base-content opacity-10 group-hover:opacity-35 group-hover:rotate-45 transition-all duration-700 pointer-events-none select-none"
    viewBox="0 0 100 100"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="50"
      cy="50"
      r="32"
      stroke="currentColor"
      stroke-width="0.6"
      stroke-dasharray="2 3"
    ></circle>
    <circle
      cx="50"
      cy="50"
      r="44"
      stroke="currentColor"
      stroke-width="0.4"
    ></circle>
    <circle cx="50" cy="18" r="1.8" fill="currentColor"></circle>
    <circle cx="82" cy="50" r="1.4" fill="currentColor"></circle>
  </svg>

  <div class="avatar placeholder shrink-0 group-hover:scale-110 transition-transform duration-300 relative z-10">
    <div class="bg-base-300/80 border border-base-content/10 text-neutral-content rounded-xl w-12 h-12 flex items-center justify-center overflow-hidden shadow-xs">
      <Image
        src={imageImport()}
        alt={item.institution}
        width={48}
        height={48}
        class="p-1 object-contain"
      />
    </div>
  </div>
  <div class="flex-1 min-w-0 relative z-10">
    <h3 class="font-bold text-sm md:text-base group-hover:text-primary transition-colors">
      {item.title}
    </h3>
    <p class="text-xs font-medium opacity-80">{item.institution}</p>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-2 text-xs text-base-content/80">
      <span>{item.date}</span>
      <span class="opacity-40">•</span>
      <span>{item.location}</span>
      {item.gpa && (
        <>
          <span class="opacity-40">•</span>
          <span class="badge badge-sm badge-outline badge-primary font-semibold text-xs px-1.5 py-0 h-auto">
            {t("education.gpa")}: {item.gpa}
          </span>
        </>
      )}
    </div>
    <p class="text-xs md:text-sm mt-3 leading-relaxed">{item.description}</p>
    {item.link && (
      <div class="mt-3">
        <a
          href={getLinkUrl(item.link.url)}
          target={item.link.url.startsWith("http") ? "_blank" : undefined}
          rel={
            item.link.url.startsWith("http") ? "noopener noreferrer" : undefined
          }
          class="link link-primary text-xs font-semibold inline-flex items-center gap-1 hover:underline"
        >
          <LinkIcon class="w-3.5 h-3.5" />
          {item.link.text} &rarr;
        </a>
      </div>
    )}
  </div>
</div>
