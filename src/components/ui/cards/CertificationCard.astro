---
import { useTranslations } from "../../../i18n/utils";
import type { Certification } from "../../../types";
import { Image } from "astro:assets";

interface Props {
  item: Certification;
}

const { item } = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);

// Dynamically resolve optimized certificate image from src/assets/images/certs/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/certs/*.{jpeg,jpg,png,gif,webp}",
);
const imageImport = images[item.logo]!;
---

<div
  data-spotlight="true"
  class="group relative overflow-hidden card bg-base-200/90 md:bg-base-200/55 md:backdrop-blur-md border border-base-content/10 p-4 flex flex-row gap-4 items-start hover:-translate-y-1 hover:border-base-content/30 hover:shadow-[0_12px_28px_-10px_rgba(0,0,0,0.35)] transition-all duration-300 rounded-xl"
>
  <!-- Subtle Monochromatic Orbital Arc & Star Corner -->
  <svg
    class="absolute -top-4 -right-4 w-20 h-20 text-base-content opacity-10 group-hover:opacity-35 transition-opacity duration-500 pointer-events-none select-none"
    viewBox="0 0 80 80"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="60"
      cy="20"
      r="28"
      stroke="currentColor"
      stroke-width="0.5"
      stroke-dasharray="2 3"
    ></circle>
    <circle cx="42" cy="38" r="1.6" fill="currentColor"></circle>
  </svg>

  <div class="avatar placeholder shrink-0 group-hover:scale-110 transition-transform duration-300 relative z-10">
    <div class="bg-base-300/80 border border-base-content/10 rounded-lg w-12 h-12 flex items-center justify-center overflow-hidden">
      <Image
        src={imageImport()}
        alt={item.institution}
        width={48}
        height={48}
        class="p-1 object-contain w-full h-full"
      />
    </div>
  </div>
  <div class="flex-1 min-w-0 relative z-10">
    <h4 class="font-bold text-xs md:text-sm leading-snug group-hover:text-primary transition-colors">
      {item.title}
    </h4>
    <p class="text-xs opacity-75 mt-0.5">
      {item.institution} · {item.date}
    </p>
    <p class="text-xs mt-2 opacity-80 leading-relaxed">{item.description}</p>
    {item.link && (
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer"
        class="link link-primary text-xs font-semibold inline-flex items-center gap-1 mt-2 hover:underline"
      >
        {t("education.viewCredential")} &rarr;
      </a>
    )}
  </div>
</div>
