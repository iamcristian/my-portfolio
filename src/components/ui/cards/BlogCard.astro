---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../../i18n/utils";
import { getReadTime } from "../../../utils/blog";
import CalendarIcon from "../../../assets/icons/calendar.svg";
import ClockIcon from "../../../assets/icons/clock.svg";
import ShieldIcon from "../../../assets/icons/shield.svg";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"blog">;
  isFeatured?: boolean;
  showFeaturedBadge?: boolean;
  loading?: "lazy" | "eager";
  class?: string;
  [key: `data-${string}`]: string | undefined;
  headingLevel?: "h2" | "h3";
}

const {
  headingLevel: Heading = "h3",
  post,
  isFeatured = false,
  showFeaturedBadge = false,
  loading = "lazy",
  class: className,
  ...rest
} = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);
---

{isFeatured ? (
  <article
    data-spotlight="true"
    class:list={[
      "relative card md:card-side bg-base-200/90 md:bg-base-200/55 md:backdrop-blur-md border border-base-content/10 hover:-translate-y-1 hover:border-base-content/30 hover:shadow-[0_18px_38px_-12px_rgba(0,0,0,0.4)] transition-all duration-300 overflow-hidden flex flex-col md:flex-row gap-6 p-6 group/card w-full",
      className,
    ]}
    {...rest}
  >
    <!-- Subtle Monochromatic Constellation Watermark -->
    <svg
      class="absolute top-3 right-3 w-32 h-24 text-base-content opacity-10 group-hover/card:opacity-35 transition-opacity duration-500 pointer-events-none select-none"
      viewBox="0 0 120 80"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M 20 55 L 55 25 L 85 45 L 110 18"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="2 2"
      ></path>
      <circle cx="20" cy="55" r="1.4" fill="currentColor"></circle>
      <circle cx="55" cy="25" r="1.8" fill="currentColor"></circle>
      <circle cx="85" cy="45" r="1.4" fill="currentColor"></circle>
      <circle cx="110" cy="18" r="1.8" fill="currentColor"></circle>
    </svg>

    <div class="w-full md:w-5/12 overflow-hidden rounded-xl bg-base-300 relative min-h-50 shrink-0">
      <Image
        src={post.data.image}
        alt={post.data.imageAlt || post.data.title}
        widths={[400, 600, 900]}
        sizes="(min-width: 768px) 450px, calc(100vw - 64px)"
        width={600}
        height={350}
        loading={loading}
        class="absolute inset-0 w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
      />
      <span class="badge bg-neutral-900/85 md:bg-neutral-900/60 text-white border-none gap-1.5 py-3 px-3.5 absolute top-3 left-3 md:backdrop-blur-md text-xs font-semibold rounded-full shadow-sm">
        <ShieldIcon class="w-3.5 h-3.5 text-white/90" />
        <span>{t("blog.featured")}</span>
      </span>
    </div>
    <div class="flex-1 flex flex-col justify-between relative z-10">
      <div class="space-y-2">
        <div class="flex gap-4 text-xs text-base-content/80">
          <span class="flex items-center gap-1">
            <CalendarIcon class="w-4 h-4" />
            <span>
              {new Intl.DateTimeFormat(lang, {
                dateStyle: "long",
                timeZone: "UTC",
              }).format(post.data.date)}
            </span>
          </span>
          <span class="flex items-center gap-1">
            <ClockIcon class="w-4 h-4" />
            <span>
              {getReadTime(post.body, post.data.lang)} {t("blog.readTime")}
            </span>
          </span>
        </div>
        <Heading class="card-title text-base md:text-lg font-bold">
          <a
            href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
            class="hover:text-primary transition-colors"
          >
            {post.data.title}
          </a>
        </Heading>
        <p class="text-xs opacity-80 line-clamp-3 leading-relaxed">
          {post.data.description}
        </p>
        <div class="flex flex-wrap gap-1.5 mt-2">
          {post.data.tags.map((tag) => (
            <span class="badge badge-xs font-mono bg-base-300/50 border border-base-content/10 text-base-content/80 hover:text-primary transition-colors py-2 px-2">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div class="border-t border-base-content/10 pt-4 mt-4 flex items-center justify-between">
        <a
          href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
          class="btn btn-ghost btn-sm w-fit border border-base-content/10 hover:border-primary/30 group/btn"
        >
          {t("blog.readMore")}{" "}
          <span class="group-hover/btn:translate-x-1 transition-transform inline-block ml-1">
            &rarr;
          </span>
          <span class="sr-only">: {post.data.title}</span>
        </a>
      </div>
    </div>
  </article>
) : (
  <article
    data-spotlight="true"
    data-tilt="true"
    class:list={[
      "blog-card relative overflow-hidden card card-compact bg-base-200/90 md:bg-base-200/55 md:backdrop-blur-md border border-base-content/10 hover:-translate-y-1 hover:border-base-content/30 hover:shadow-[0_18px_38px_-12px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col h-full group/card",
      className,
    ]}
    {...rest}
  >
    <!-- Subtle Monochromatic Orbital Arc in Blog Card Body -->
    <svg
      class="absolute bottom-2 right-2 w-24 h-24 text-base-content opacity-10 group-hover/card:opacity-30 transition-opacity duration-500 pointer-events-none select-none z-0"
      viewBox="0 0 90 90"
      fill="none"
      aria-hidden="true"
    >
      <circle
        cx="72"
        cy="72"
        r="32"
        stroke="currentColor"
        stroke-width="0.5"
        stroke-dasharray="2 3"
      ></circle>
      <circle cx="40" cy="72" r="1.4" fill="currentColor"></circle>
      <circle cx="72" cy="40" r="1.4" fill="currentColor"></circle>
    </svg>

    <figure class="blog-figure relative h-44 bg-base-300 shrink-0 transition-all overflow-hidden">
      <Image
        src={post.data.image}
        alt={post.data.imageAlt || post.data.title}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, calc(100vw - 32px)"
        width={400}
        height={225}
        loading={loading}
        class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
      />
      {showFeaturedBadge && (
        <span class="badge bg-neutral-900/85 md:bg-neutral-900/60 text-white border-none gap-1.5 py-3 px-3.5 absolute top-3 left-3 md:backdrop-blur-md text-xs font-semibold rounded-full shadow-sm">
          <ShieldIcon class="w-3.5 h-3.5 text-white/90" />
          <span>{t("blog.featured")}</span>
        </span>
      )}
    </figure>
    <div class="blog-body card-body flex-1 flex flex-col justify-start p-5 transition-all relative z-10">
      <div class="space-y-3">
        <div class="flex flex-wrap gap-3 text-xs text-base-content/80 items-center">
          {showFeaturedBadge && (
            <span class="blog-metadata-featured-badge badge badge-secondary badge-xs font-semibold gap-1 py-2 px-2 text-xs rounded-full shrink-0">
              <ShieldIcon class="w-3 h-3 text-secondary-content" />
              <span>{t("blog.featured")}</span>
            </span>
          )}
          <span class="flex items-center gap-1">
            <CalendarIcon class="w-3.5 h-3.5" />
            <span>
              {new Intl.DateTimeFormat(lang, {
                dateStyle: "medium",
                timeZone: "UTC",
              }).format(post.data.date)}
            </span>
          </span>
          <span class="flex items-center gap-1">
            <ClockIcon class="w-3.5 h-3.5" />
            <span>
              {getReadTime(post.body, post.data.lang)} {t("blog.readTime")}
            </span>
          </span>
        </div>
        <Heading class="card-title text-sm font-bold leading-snug">
          <a
            href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
            class="hover:text-primary transition-colors blog-title"
          >
            {post.data.title}
          </a>
        </Heading>
        <p class="text-xs opacity-80 line-clamp-2 leading-relaxed blog-desc">
          {post.data.description}
        </p>
        <div class="flex flex-wrap gap-1">
          {post.data.tags.map((tag) => (
            <span class="badge badge-xs font-mono bg-base-300/50 border border-base-content/10 text-base-content/80 hover:text-primary transition-colors py-2 px-2">
              {tag}
            </span>
          ))}
        </div>
      </div>
      <div class="blog-footer pt-4 border-t border-base-300 mt-4 transition-all">
        <a
          href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
          class="btn btn-ghost btn-sm w-fit border border-base-content/10 hover:border-primary/30 group/btn"
        >
          {t("blog.readMore")}{" "}
          <span class="group-hover/btn:translate-x-1 transition-transform inline-block ml-1">
            &rarr;
          </span>
          <span class="sr-only">: {post.data.title}</span>
        </a>
      </div>
    </div>
  </article>
)}

<style>
  /* Hide the metadata featured badge in grid view (where card-compact class is present) */
  .blog-card.card-compact .blog-metadata-featured-badge {
    display: none !important;
  }
</style>
