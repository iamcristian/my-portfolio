---
import { useTranslations } from "../../../i18n/utils";
import type { Project } from "../../../types";
import { Image } from "astro:assets";
import { featureCopy } from "../../../i18n/features";
import ShieldIcon from "../../../assets/icons/shield.svg";
import fallbackImage from "../../../assets/images/website.webp";

interface Props {
  project: Project;
  loading?: "lazy" | "eager";
  showFeaturedBadge?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  headingLevel?: "h2" | "h3";
}

const {
  headingLevel: Heading = "h3",
  project,
  loading = "lazy",
  showFeaturedBadge = false,
  class: className,
  ...rest
} = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);

// Dynamically resolve optimized project image from src/assets/images/projects/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{jpeg,jpg,png,gif,webp}",
);
const imageImport = images[project.image];
const isExternal = project.image.startsWith("http");
const localImage = imageImport ? imageImport() : fallbackImage;
---

<article
  data-spotlight="true"
  data-tilt="true"
  class:list={[
    "project-card card card-compact bg-base-200/55 backdrop-blur-md border border-base-content/10 overflow-hidden hover:border-primary/45 hover:shadow-[0_18px_38px_-12px_rgba(59,130,246,0.22)] transition-all duration-300 flex flex-col h-full group/card relative",
    className,
  ]}
  {...rest}
>
  <!-- Dynamic cursor spotlight highlight -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 rounded-[inherit] z-10"
    style="background: radial-gradient(350px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), color-mix(in oklch, var(--color-primary) 7%, transparent), transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Subtle Celestial Orbital Vector in Card Body -->
  <svg
    class="absolute bottom-2 right-2 w-28 h-28 text-base-content opacity-10 group-hover/card:opacity-35 transition-opacity duration-500 pointer-events-none select-none z-0"
    viewBox="0 0 100 100"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="80"
      cy="80"
      r="36"
      stroke="currentColor"
      stroke-width="0.5"
      stroke-dasharray="2 3"
    ></circle>
    <circle
      cx="80"
      cy="80"
      r="54"
      stroke="currentColor"
      stroke-width="0.4"
    ></circle>
    <path
      d="M44 80 C44 82 44 82 46 83 C44 83 44 84 44 86 C44 84 44 84 42 83 C44 83 44 82 44 80 Z"
      fill="#fbbf24"
    ></path>
    <circle cx="80" cy="26" r="1.5" fill="#60a5fa"></circle>
  </svg>

  <figure class="project-figure relative h-48 bg-base-300 shrink-0 transition-all overflow-hidden">
    {isExternal ? (
      <Image
        src={project.image}
        alt={project.title}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, calc(100vw - 32px)"
        width={400}
        height={225}
        loading={loading}
        class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
      />
    ) : (
      <Image
        src={localImage}
        alt={project.title}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, calc(100vw - 32px)"
        width={400}
        height={225}
        loading={loading}
        class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
      />
    )}
    {(project.featured || showFeaturedBadge) && (
      <span class="badge bg-neutral-900/60 text-white border-none gap-1.5 py-3 px-3.5 absolute top-3 left-3 backdrop-blur-md text-xs font-semibold rounded-full shadow-sm">
        <ShieldIcon class="w-3.5 h-3.5 text-amber-400" />
        <span>{t("blog.featured")}</span>
      </span>
    )}
  </figure>
  <div class="project-body card-body flex-1 flex flex-col justify-between p-5 transition-all relative z-10">
    <div class="space-y-3">
      <div class="flex flex-col gap-2">
        {(project.featured || showFeaturedBadge) && (
          <span class="body-featured-badge badge badge-secondary badge-xs font-semibold gap-1 py-2 px-2 text-xs rounded-full shrink-0 w-fit">
            <ShieldIcon class="w-3 h-3 text-secondary-content" />
            <span>{t("blog.featured")}</span>
          </span>
        )}
        <Heading class="card-title text-sm md:text-base hover:text-primary transition-colors project-title">
          <a href={`/${lang}/projects/${project.id}/`}>{project.title}</a>
        </Heading>
      </div>
      <p class="text-xs opacity-80 line-clamp-3 leading-relaxed project-desc">
        {project.description}
      </p>
      <div class="flex flex-wrap gap-1 mt-2">
        {project.tech.map((techItem) => (
          <span class="badge badge-xs font-mono bg-base-300/50 border border-base-content/10 text-base-content/80 hover:text-primary transition-colors py-2 px-2">
            {techItem}
          </span>
        ))}
      </div>
    </div>
    <div class="project-footer card-actions justify-start gap-2 pt-4 mt-auto border-t border-base-300 transition-all">
      <a
        href={`/${lang}/projects/${project.id}/`}
        class="btn btn-xs btn-primary"
      >
        {featureCopy(lang).caseStudy}
      </a>
      <a href={project.github} target="_blank" class="btn btn-xs btn-outline">
        {t("projects.code")}
      </a>
      {project.live && (
        <a href={project.live} target="_blank" class="btn btn-xs btn-primary">
          {t("projects.demo")}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .body-featured-badge {
    display: none;
  }

  :global(.project-card:not(.card-compact)) .body-featured-badge {
    display: inline-flex;
  }
</style>
