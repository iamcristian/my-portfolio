---
// Celestial Orbital Horizon Divider — echoes the Lagrange Simulation aesthetic
interface Props {
  node?: string;
}
---

<div
  class="relative w-full py-6 md:py-10 flex items-center justify-center overflow-hidden pointer-events-none select-none"
  aria-hidden="true"
>
  <!-- Horizon Starlight Line -->
  <div class="absolute inset-x-0 h-px bg-linear-to-r from-transparent via-base-content/15 to-transparent">
    <div class="absolute inset-0 bg-linear-to-r from-transparent via-base-content/30 to-transparent w-56 sm:w-80 animate-divider-beam"></div>
  </div>

  <!-- Central Monochromatic Celestial Orbital Node -->
  <div class="relative z-10 flex items-center justify-center px-4 bg-base-100/85 rounded-full">
    <svg
      class="w-16 h-7 text-base-content/50 overflow-visible"
      viewBox="0 0 80 28"
      fill="none"
    >
      <!-- Elliptical planetary orbit ring -->
      <ellipse
        cx="40"
        cy="14"
        rx="28"
        ry="7"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="2 3"
        class="opacity-40"
      />
      <!-- Inner concentric ring -->
      <circle
        cx="40"
        cy="14"
        r="5.5"
        stroke="currentColor"
        stroke-width="0.6"
        class="opacity-30"
      />
      <!-- Orbiting micro-satellite dots (monochromatic starlight) -->
      <circle
        cx="16"
        cy="11.5"
        r="1.1"
        fill="currentColor"
        class="opacity-60"
      />
      <circle
        cx="64"
        cy="16.5"
        r="1.1"
        fill="currentColor"
        class="opacity-60"
      />
      <!-- Center Starlight Core -->
      <circle cx="40" cy="14" r="1.6" fill="currentColor" class="opacity-85" />
    </svg>
  </div>
</div>
