---
// Celestial Orbital Horizon Divider — echoes the Lagrange Simulation aesthetic
interface Props {
  node?: string;
}
---

<div
  class="relative w-full py-6 md:py-10 flex items-center justify-center overflow-hidden pointer-events-none select-none"
  aria-hidden="true"
>
  <!-- Horizon Starlight Line -->
  <div class="absolute inset-x-0 h-px bg-linear-to-r from-transparent via-base-content/15 to-transparent">
    <div class="absolute inset-0 bg-linear-to-r from-transparent via-amber-300/35 to-transparent w-56 sm:w-80 animate-divider-beam"></div>
  </div>

  <!-- Central Celestial Orbital Node -->
  <div class="relative z-10 flex items-center justify-center px-4 bg-base-100/60 backdrop-blur-xs rounded-full">
    <svg
      class="w-16 h-7 text-base-content/60 overflow-visible"
      viewBox="0 0 80 28"
      fill="none"
    >
      <!-- Elliptical planetary orbit ring -->
      <ellipse
        cx="40"
        cy="14"
        rx="28"
        ry="7"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="2 3"
        class="opacity-35"
      />
      <!-- Inner concentric ring -->
      <circle
        cx="40"
        cy="14"
        r="6"
        stroke="currentColor"
        stroke-width="0.6"
        class="opacity-25"
      />
      <!-- Orbiting micro-satellite dot -->
      <circle cx="16" cy="11.5" r="1.3" fill="#60a5fa" class="opacity-80" />
      <circle cx="64" cy="16.5" r="1.1" fill="#a78bfa" class="opacity-75" />
      <!-- Center 4-Point Diamond Star -->
      <path
        d="M40 7 C40 11.5 40 11.5 44.5 14 C40 14 40 16.5 40 21 C40 16.5 40 16.5 35.5 14 C40 14 40 11.5 40 7 Z"
        fill="#fef08a"
        class="opacity-85"
      />
    </svg>
  </div>
</div>
