---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface TopologyNode {
  id: string;
  label: string;
  category:
    | "languages"
    | "frontend"
    | "backend"
    | "databases"
    | "devops"
    | "security"
    | "ai";
  categoryName: string;
  x: number;
  y: number;
  size: number;
  isHub?: boolean;
  connections: string[];
}

const NODES: TopologyNode[] = [
  // ── Core Hubs ──
  {
    id: "typescript",
    label: "TypeScript",
    category: "languages",
    categoryName: "Languages",
    x: 380,
    y: 220,
    size: 20,
    isHub: true,
    connections: ["nextjs", "astro", "react", "nestjs", "nodejs", "mcp"],
  },
  {
    id: "python",
    label: "Python",
    category: "languages",
    categoryName: "Languages",
    x: 530,
    y: 210,
    size: 20,
    isHub: true,
    connections: ["fastapi", "django", "timescaledb", "agentic", "mcp"],
  },
  {
    id: "linux",
    label: "Linux",
    category: "devops",
    categoryName: "DevOps & Systems",
    x: 450,
    y: 350,
    size: 20,
    isHub: true,
    connections: ["docker", "git", "netsec", "owasp"],
  },

  // ── Frontend Tier ──
  {
    id: "nextjs",
    label: "Next.js",
    category: "frontend",
    categoryName: "Frontend",
    x: 230,
    y: 140,
    size: 15,
    connections: ["typescript", "react", "tailwind"],
  },
  {
    id: "astro",
    label: "Astro",
    category: "frontend",
    categoryName: "Frontend",
    x: 240,
    y: 270,
    size: 15,
    connections: ["typescript", "tailwind"],
  },
  {
    id: "react",
    label: "React",
    category: "frontend",
    categoryName: "Frontend",
    x: 100,
    y: 130,
    size: 13,
    connections: ["nextjs"],
  },
  {
    id: "tailwind",
    label: "Tailwind CSS",
    category: "frontend",
    categoryName: "Frontend",
    x: 110,
    y: 260,
    size: 13,
    connections: ["nextjs", "astro"],
  },

  // ── Backend Tier ──
  {
    id: "nodejs",
    label: "Node.js",
    category: "backend",
    categoryName: "Backend Architecture",
    x: 310,
    y: 90,
    size: 15,
    connections: ["typescript", "nestjs", "docker"],
  },
  {
    id: "nestjs",
    label: "NestJS",
    category: "backend",
    categoryName: "Backend Architecture",
    x: 430,
    y: 80,
    size: 15,
    connections: ["typescript", "nodejs", "postgresql", "redis", "apisec"],
  },
  {
    id: "fastapi",
    label: "FastAPI",
    category: "backend",
    categoryName: "Backend Architecture",
    x: 580,
    y: 90,
    size: 15,
    connections: ["python", "postgresql", "timescaledb", "apisec", "docker"],
  },
  {
    id: "django",
    label: "Django",
    category: "backend",
    categoryName: "Backend Architecture",
    x: 690,
    y: 120,
    size: 13,
    connections: ["python", "postgresql"],
  },

  // ── Data Tier ──
  {
    id: "postgresql",
    label: "PostgreSQL",
    category: "databases",
    categoryName: "Data Systems",
    x: 660,
    y: 250,
    size: 16,
    connections: ["nestjs", "fastapi", "django", "timescaledb"],
  },
  {
    id: "redis",
    label: "Redis",
    category: "databases",
    categoryName: "Data Systems",
    x: 770,
    y: 230,
    size: 13,
    connections: ["nestjs", "postgresql"],
  },
  {
    id: "timescaledb",
    label: "TimescaleDB",
    category: "databases",
    categoryName: "Data Systems",
    x: 700,
    y: 350,
    size: 14,
    connections: ["postgresql", "python", "fastapi"],
  },

  // ── DevOps & Systems ──
  {
    id: "docker",
    label: "Docker",
    category: "devops",
    categoryName: "DevOps & Systems",
    x: 320,
    y: 390,
    size: 15,
    connections: ["linux", "cicd", "nodejs", "fastapi"],
  },
  {
    id: "cicd",
    label: "CI/CD & Actions",
    category: "devops",
    categoryName: "DevOps & Systems",
    x: 200,
    y: 420,
    size: 13,
    connections: ["docker", "git"],
  },
  {
    id: "git",
    label: "Git",
    category: "devops",
    categoryName: "DevOps & Systems",
    x: 380,
    y: 460,
    size: 13,
    connections: ["linux", "cicd"],
  },

  // ── Security & Hardening ──
  {
    id: "apisec",
    label: "API Security",
    category: "security",
    categoryName: "Security Architecture",
    x: 560,
    y: 370,
    size: 14,
    connections: ["fastapi", "nestjs", "owasp"],
  },
  {
    id: "owasp",
    label: "OWASP",
    category: "security",
    categoryName: "Security Architecture",
    x: 490,
    y: 470,
    size: 13,
    connections: ["apisec", "linux", "netsec"],
  },
  {
    id: "netsec",
    label: "Network Security",
    category: "security",
    categoryName: "Security Architecture",
    x: 610,
    y: 460,
    size: 13,
    connections: ["linux", "owasp"],
  },

  // ── AI & Agentic ──
  {
    id: "mcp",
    label: "Model Context Protocol",
    category: "ai",
    categoryName: "Agentic Systems",
    x: 770,
    y: 90,
    size: 14,
    connections: ["python", "typescript", "agentic"],
  },
  {
    id: "agentic",
    label: "Agentic Workflows",
    category: "ai",
    categoryName: "Agentic Systems",
    x: 830,
    y: 170,
    size: 14,
    connections: ["python", "mcp"],
  },
];

// Unique links deduplicated
const LINKS: Array<{ source: TopologyNode; target: TopologyNode; id: string }> =
  [];
const nodeMap = new Map<string, TopologyNode>(NODES.map((n) => [n.id, n]));

NODES.forEach((source) => {
  source.connections.forEach((targetId) => {
    const target = nodeMap.get(targetId);
    if (!target) return;
    const linkId = [source.id, target.id].sort().join("--");
    if (!LINKS.some((l) => l.id === linkId)) {
      LINKS.push({ source, target, id: linkId });
    }
  });
});

const CATEGORIES = [
  { id: "all", label: "All Systems" },
  { id: "languages", label: "Languages" },
  { id: "backend", label: "Backend" },
  { id: "frontend", label: "Frontend" },
  { id: "databases", label: "Databases" },
  { id: "devops", label: "DevOps & Systems" },
  { id: "security", label: "Security" },
  { id: "ai", label: "AI & Agents" },
];
---

<div
  id="topology-graph-container"
  class="relative card bg-base-200 border border-base-300 p-4 sm:p-6 rounded-2xl overflow-hidden shadow-xl"
  data-spotlight="true"
>
  <!-- Background tech coordinate grid -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[linear-gradient(rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

  <!-- Ambient background glow behind core hubs -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-primary/4 blur-[100px] pointer-events-none"></div>

  <!-- Header Controls: Category Filter Buttons -->
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-base-content/10">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-success animate-ping"></span>
      <span class="font-mono text-xs uppercase tracking-wider text-base-content/80 font-medium">
        {t("skills.topologyHint")}
      </span>
    </div>

    <!-- Filter Pills -->
    <div
      class="flex flex-wrap gap-1.5"
      role="group"
      aria-label="Filter skills by architecture cluster"
    >
      {CATEGORIES.map((cat) => (
        <button
          type="button"
          data-topology-filter={cat.id}
          class:list={[
            "btn btn-xs rounded-full font-mono text-[11px] transition-all",
            cat.id === "all"
              ? "btn-primary shadow-xs"
              : "btn-ghost border border-base-content/10 hover:border-primary/40",
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Interactive SVG Canvas -->
  <div class="relative w-full overflow-x-auto overflow-y-hidden py-2 cursor-crosshair">
    <svg
      id="skills-topology-svg"
      class="w-full min-w-[760px] h-[480px] select-none"
      viewBox="0 0 920 520"
      preserveAspectRatio="xMidYMid meet"
      aria-label="Interactive architecture topology diagram"
    >
      <defs>
        <!-- Dynamic edge glow gradient -->
        <linearGradient id="edge-active-glow" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop
            offset="0%"
            stop-color="var(--color-primary)"
            stop-opacity="0.9"
          />
          <stop
            offset="50%"
            stop-color="var(--color-accent)"
            stop-opacity="0.9"
          />
          <stop
            offset="100%"
            stop-color="var(--color-primary)"
            stop-opacity="0.9"
          />
        </linearGradient>

        <!-- Core Hub Glow Filter -->
        <filter id="hub-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Connecting Architectural Edges -->
      <g class="topology-edges">
        {LINKS.map((link) => (
          <line
            id={`edge-${link.id}`}
            x1={link.source.x}
            y1={link.source.y}
            x2={link.target.x}
            y2={link.target.y}
            class="topology-edge stroke-base-content/15 transition-all duration-300"
            stroke-width="1.25"
            stroke-dasharray="3 3"
            data-source={link.source.id}
            data-target={link.target.id}
          />
        ))}
      </g>

      <!-- Architecture Nodes -->
      <g class="topology-nodes">
        {NODES.map((node) => (
          <g
            id={`node-${node.id}`}
            class="topology-node cursor-pointer group/node transition-all duration-300"
            data-node-id={node.id}
            data-category={node.category}
            data-label={node.label}
            data-category-name={node.categoryName}
            data-connections={node.connections.join(",")}
            tabindex="0"
            role="button"
            aria-label={`${node.label} (${node.categoryName})`}
          >
            <!-- Outer halo ring for hubs -->
            {node.isHub && (
              <circle
                cx={node.x}
                cy={node.y}
                r={node.size + 8}
                class="stroke-primary/20 fill-primary/5 transition-all duration-300 pointer-events-none animate-pulse"
                stroke-width="1"
              />
            )}

            <!-- Node Body Circle -->
            <circle
              cx={node.x}
              cy={node.y}
              r={node.size}
              class:list={[
                "node-circle transition-all duration-300 stroke-base-content/20 fill-base-100",
                node.isHub
                  ? "stroke-primary/60 fill-base-300/80"
                  : "hover:stroke-primary",
              ]}
              stroke-width={node.isHub ? 2 : 1.5}
            />

            <!-- Center Core Dot -->
            <circle
              cx={node.x}
              cy={node.y}
              r={node.isHub ? 4.5 : 3}
              class="fill-primary node-core transition-all duration-300 pointer-events-none"
            />

            <!-- Node Label -->
            <text
              x={node.x}
              y={node.y + node.size + 14}
              text-anchor="middle"
              class="node-label font-mono text-[11px] font-medium fill-base-content/85 pointer-events-none transition-all duration-300"
            >
              {node.label}
            </text>
          </g>
        ))}
      </g>
    </svg>
  </div>

  <!-- Telemetry HUD Footer: Dynamic Node Details Bar -->
  <div
    id="topology-hud"
    class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-3 mt-3 pt-3 border-t border-base-content/10 bg-base-300/40 rounded-xl px-4 py-3 font-mono text-xs"
  >
    <div class="flex items-center gap-3">
      <div class="w-2.5 h-2.5 rounded-full bg-primary animate-ping"></div>
      <div class="space-y-0.5">
        <div class="flex items-center gap-2">
          <span class="text-base-content/50 uppercase tracking-wider text-[10px]">
            SELECTED NODE:
          </span>
          <span id="hud-node-label" class="text-primary font-bold">
            TypeScript
          </span>
          <span
            id="hud-node-category"
            class="badge badge-xs badge-outline font-mono text-[9px]"
          >
            Languages
          </span>
        </div>
        <div class="text-[11px] text-base-content/70">
          <span class="opacity-50">INTERCONNECTIONS: </span>
          <span
            id="hud-node-connections"
            class="text-base-content/90 font-medium"
          >
            Next.js, Astro, React, NestJS, Node.js, MCP
          </span>
        </div>
      </div>
    </div>

    <a
      id="hud-evidence-link"
      href={`/${lang}/search/?q=TypeScript&evidence=1`}
      class="btn btn-xs btn-primary gap-1.5 rounded-full font-mono text-[10px] shrink-0"
    >
      <span>INSPECT EVIDENCE</span>
      <span>&rarr;</span>
    </a>
  </div>
</div>

<style>
  .topology-edge.active-edge {
    stroke: var(--color-primary);
    stroke-width: 2.25px;
    stroke-dasharray: none;
    filter: drop-shadow(
      0 0 6px color-mix(in oklch, var(--color-primary) 60%, transparent)
    );
    opacity: 1 !important;
  }
  .topology-edge.dimmed {
    opacity: 0.1 !important;
  }
  .topology-node.dimmed {
    opacity: 0.2 !important;
  }
  .topology-node.active-node .node-circle {
    stroke: var(--color-primary);
    stroke-width: 2.5px;
    fill: color-mix(in oklch, var(--color-primary) 15%, var(--color-base-100));
    filter: drop-shadow(
      0 0 8px color-mix(in oklch, var(--color-primary) 50%, transparent)
    );
  }
  .topology-node.active-node .node-label {
    fill: var(--color-primary);
    font-weight: 700;
  }
</style>

<script>
  function initTopologyGraph() {
    const container = document.getElementById("topology-graph-container");
    if (!container) return;

    const svg = document.getElementById("skills-topology-svg");
    const nodes = container.querySelectorAll<SVGGElement>(".topology-node");
    const edges = container.querySelectorAll<SVGLineElement>(".topology-edge");
    const filterBtns = container.querySelectorAll<HTMLButtonElement>(
      "[data-topology-filter]",
    );

    const hudLabel = document.getElementById("hud-node-label");
    const hudCategory = document.getElementById("hud-node-category");
    const hudConnections = document.getElementById("hud-node-connections");
    const hudLink = document.getElementById(
      "hud-evidence-link",
    ) as HTMLAnchorElement | null;

    let activeFilter = "all";

    function highlightNode(nodeEl: SVGGElement) {
      const nodeId = nodeEl.dataset.nodeId!;
      const label = nodeEl.dataset.label!;
      const categoryName = nodeEl.dataset.categoryName!;
      const connections = (nodeEl.dataset.connections || "")
        .split(",")
        .filter(Boolean);

      // Update HUD
      if (hudLabel) hudLabel.textContent = label;
      if (hudCategory) hudCategory.textContent = categoryName;
      if (hudConnections)
        hudConnections.textContent =
          connections.join(", ") || "Autonomous System Component";
      if (hudLink) {
        const currentLang = document.documentElement.lang || "en";
        hudLink.href = `/${currentLang}/search/?q=${encodeURIComponent(label)}&evidence=1`;
      }

      // Highlight edges
      edges.forEach((edge) => {
        const source = edge.dataset.source;
        const target = edge.dataset.target;
        const isConnected = source === nodeId || target === nodeId;
        edge.classList.toggle("active-edge", isConnected);
        edge.classList.toggle("dimmed", !isConnected);
      });

      // Highlight neighbor nodes
      nodes.forEach((node) => {
        const id = node.dataset.nodeId!;
        const isNeighbor = id === nodeId || connections.includes(id);
        node.classList.toggle("active-node", id === nodeId);
        node.classList.toggle("dimmed", !isNeighbor);
      });
    }

    function resetHighlight() {
      edges.forEach((edge) => {
        edge.classList.remove("active-edge", "dimmed");
      });
      nodes.forEach((node) => {
        node.classList.remove("active-node");
        if (activeFilter === "all") {
          node.classList.remove("dimmed");
        } else {
          node.classList.toggle(
            "dimmed",
            node.dataset.category !== activeFilter,
          );
        }
      });
    }

    // Node interactions
    nodes.forEach((node) => {
      node.addEventListener("mouseenter", () => highlightNode(node));
      node.addEventListener("focus", () => highlightNode(node));
      node.addEventListener("focusin", () => highlightNode(node));

      node.addEventListener("click", () => {
        const label = node.dataset.label!;
        const currentLang = document.documentElement.lang || "en";
        window.location.assign(
          `/${currentLang}/search/?q=${encodeURIComponent(label)}&evidence=1`,
        );
      });

      node.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const label = node.dataset.label!;
          const currentLang = document.documentElement.lang || "en";
          window.location.assign(
            `/${currentLang}/search/?q=${encodeURIComponent(label)}&evidence=1`,
          );
        }
      });
    });

    svg?.addEventListener("mouseleave", () => {
      resetHighlight();
    });

    // Category filters
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.topologyFilter!;
        activeFilter = filter;

        filterBtns.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle("btn-primary", isActive);
          b.classList.toggle("btn-ghost", !isActive);
          if (isActive) b.classList.add("shadow-xs");
          else b.classList.remove("shadow-xs");
        });

        nodes.forEach((node) => {
          if (filter === "all") {
            node.classList.remove("dimmed");
          } else {
            const matches = node.dataset.category === filter;
            node.classList.toggle("dimmed", !matches);
          }
        });

        edges.forEach((edge) => {
          if (filter === "all") {
            edge.classList.remove("dimmed");
          } else {
            const sNode = container.querySelector<SVGGElement>(
              `[data-node-id="${edge.dataset.source}"]`,
            );
            const tNode = container.querySelector<SVGGElement>(
              `[data-node-id="${edge.dataset.target}"]`,
            );
            const sMatches = sNode?.dataset.category === filter;
            const tMatches = tNode?.dataset.category === filter;
            edge.classList.toggle("dimmed", !(sMatches || tMatches));
          }
        });
      });
    });
  }

  initTopologyGraph();
  document.addEventListener("astro:page-load", initTopologyGraph);
</script>
