---
import { useTranslations } from "../../i18n/utils";

interface Props {
  id?: string;
  index: number;
  totalItems: number;
  title: string;
  company: string;
  companyUrl?: string;
  date: string;
  description: string;
  responsibilities: string[];
  tags: string[];
}

const {
  id,
  index,
  totalItems,
  title,
  company,
  companyUrl,
  date,
  description,
  responsibilities,
  tags,
} = Astro.props;

const isEven = index % 2 === 0;
const num = index + 1;

const { lang } = Astro.locals;
const t = useTranslations(lang);
---

<li id={id} tabindex={id ? -1 : undefined} class="scroll-mt-24 group">
  {index !== 0 && (
    <hr class="bg-gradient-to-b from-primary/20 via-primary/50 to-primary/30 border-none w-0.5" />
  )}
  <div class="timeline-middle px-1">
    <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-base-200 border border-primary/40 shadow-[0_0_15px_color-mix(in_oklch,var(--color-primary)_20%,transparent)] group-hover:border-primary transition-colors">
      <span class="absolute inset-0 rounded-full bg-primary/15 animate-ping"></span>
      <span class="font-mono font-bold text-xs text-primary z-10">{num}</span>
    </div>
  </div>
  <div
    data-spotlight="true"
    class:list={[
      isEven ? "timeline-start mb-10" : "timeline-end mb-10",
      "card bg-base-200 border border-base-300 p-6 w-full ml-2 md:ml-0 text-left hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-[0_15px_30px_-10px_color-mix(in_oklch,var(--color-primary)_12%,transparent)] transition-all duration-300 relative",
    ]}
  >
    <!-- Header: Position, Company, Date -->
    <div class="flex flex-col gap-1 mb-4">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-base md:text-lg font-bold text-primary leading-tight">
          {title}
        </h3>
        <span class="font-mono text-[10px] tracking-wider uppercase px-2 py-0.5 rounded-full bg-base-300/80 border border-base-content/10 text-base-content/70">
          NODE.0{num}
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
        {companyUrl ? (
          <a
            href={companyUrl}
            target="_blank"
            class="font-semibold text-secondary hover:underline"
          >
            {company}
          </a>
        ) : (
          <span class="font-semibold text-secondary">{company}</span>
        )}
        <span class="text-base-content/30">•</span>
        <span class="font-mono text-xs text-base-content/80">{date}</span>
      </div>
    </div>

    <!-- Brief Description -->
    <p class="text-xs md:text-sm leading-relaxed mb-4 opacity-85">
      {description}
    </p>

    <!-- Key Responsibilities -->
    <div class="mb-4">
      <h4 class="text-xs font-bold tracking-wider uppercase text-base-content/80 mb-2">
        {t("experience.responsibilities")}
      </h4>
      <ul class="list-disc list-outside pl-4 space-y-1.5 text-xs opacity-80">
        {responsibilities.map((resp) => (
          <li>{resp}</li>
        ))}
      </ul>
    </div>

    <!-- Technologies Stack -->
    <div>
      <h4 class="text-xs font-bold tracking-wider uppercase text-base-content/80 mb-2">
        {t("experience.technologies")}
      </h4>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="badge badge-xs font-mono bg-base-300/50 border border-base-content/10 text-base-content/80 hover:text-primary transition-colors py-2 px-2 h-auto">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
  {index !== totalItems - 1 && (
    <hr class="bg-gradient-to-b from-primary/30 via-primary/50 to-primary/20 border-none w-0.5" />
  )}
</li>

<style>
  li:target > .card {
    border-color: var(--color-primary);
    background: var(--color-base-200);
    outline: 1px solid var(--color-primary);
    outline-offset: 4px;
  }
</style>
