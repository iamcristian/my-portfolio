---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
import ThemeController from "./ThemeController.astro";
import LanguageController from "./LanguageController.astro";
import { featureCopy } from "../i18n/features";
import SearchIcon from "../assets/icons/search.svg";
import MenuIcon from "../assets/icons/menu.svg";

const { lang } = Astro.locals;
const t = useTranslations(lang);
const c = featureCopy(lang);

const homeUrl = getRelativeLocaleUrl(lang, "");

const NAV_LINKS = [
  { href: `${homeUrl}#home`, label: t("nav.home") },
  { href: `${homeUrl}#about`, label: t("nav.about") },
  { href: `${homeUrl}#education`, label: t("nav.education") },
  { href: `${homeUrl}#experience`, label: t("nav.experience") },
  { href: getRelativeLocaleUrl(lang, "projects"), label: t("nav.projects") },
  { href: `${homeUrl}#skills`, label: t("nav.skills") },
  { href: getRelativeLocaleUrl(lang, "blog"), label: t("nav.blog") },
];
---

<header
  id="main-header"
  class="sticky top-0 z-50 backdrop-blur-xl bg-base-100/50 border-b border-base-content/5 w-full transition-all duration-300 py-2"
>
  <nav
    id="main-navbar"
    class="navbar max-w-6xl mx-auto px-4 md:px-8 transition-all duration-300"
    aria-label={t("nav.mainLabel")}
  >
    <!-- Navbar Start: Burger menu (mobile) + Name -->
    <div class="navbar-start">
      <details class="dropdown lg:hidden">
        <summary
          class="btn btn-ghost btn-circle"
          aria-label={t("nav.toggleMenu")}
        >
          <MenuIcon />
        </summary>
        <ul class="dropdown-content menu menu-sm bg-base-200 text-base-content rounded-box w-36 p-2 shadow-2xl border border-base-content/10 z-50">
          <li class="menu-title text-xs">{t("nav.title")}</li>
          {NAV_LINKS.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </details>
      <a
        href={homeUrl}
        class="lg:text-xl font-bold ml-2 lg:ml-0 whitespace-nowrap inline-flex items-center gap-2 group"
      >
        <svg
          class="w-3.5 h-3.5 text-amber-300/90 group-hover:rotate-45 group-hover:scale-110 transition-transform duration-500 shrink-0"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z"></path>
        </svg>
        <span>{t("home.name")}</span>
      </a>
    </div>

    <!-- Navbar Center: Navigation links (desktop) -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-medium hover:text-primary transition-colors duration-200"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Navbar End: Theme and Language selectors -->
    <div class="navbar-end items-center gap-1">
      <a
        href={getRelativeLocaleUrl(lang, "search")}
        class="btn btn-ghost btn-sm h-10 gap-1.5"
        aria-label={c.search}
        aria-keyshortcuts="Control+k Meta+k"
      >
        <SearchIcon class="block size-4 shrink-0" aria-hidden="true" />
        <span class="hidden xl:inline">{c.search}</span>
      </a>
      <LanguageController />
      <ThemeController />
    </div>
  </nav>

  <!-- Subtle Planetary Horizon Refraction Line (tracks scroll progress seamlessly along bottom edge) -->
  <div
    id="header-progress"
    class="absolute bottom-0 inset-x-0 h-[1px] overflow-hidden opacity-0 pointer-events-none transition-opacity duration-500"
    aria-hidden="true"
  >
    <div
      id="header-progress-bar"
      class="h-full w-0 transition-[width] duration-100"
      style="background: linear-gradient(90deg, transparent 0%, #3b82f6 35%, #fbbf24 70%, #8b5cf6 100%); box-shadow: 0 0 12px rgba(251, 191, 36, 0.5);"
    ></div>
  </div>
</header>
