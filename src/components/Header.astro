---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
import ThemeController from "./ThemeController.astro";
import LanguageController from "./LanguageController.astro";
import { featureCopy } from "../i18n/features";
import SearchIcon from "../assets/icons/search.svg";
import MenuIcon from "../assets/icons/menu.svg";

const { lang } = Astro.locals;
const t = useTranslations(lang);
const c = featureCopy(lang);

const homeUrl = getRelativeLocaleUrl(lang, "");

const NAV_LINKS = [
  { href: `${homeUrl}#home`, label: t("nav.home") },
  { href: `${homeUrl}#about`, label: t("nav.about") },
  { href: `${homeUrl}#education`, label: t("nav.education") },
  { href: `${homeUrl}#experience`, label: t("nav.experience") },
  { href: getRelativeLocaleUrl(lang, "projects"), label: t("nav.projects") },
  { href: `${homeUrl}#skills`, label: t("nav.skills") },
  { href: getRelativeLocaleUrl(lang, "blog"), label: t("nav.blog") },
];
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full transition-all duration-300 py-2.5 px-3 sm:px-6 flex justify-center pointer-events-none"
>
  <nav
    id="main-navbar"
    class="navbar max-w-6xl w-full mx-auto px-4 md:px-8 transition-all duration-300 backdrop-blur-md bg-base-100/30 border-b border-base-content/5 relative pointer-events-auto"
    aria-label={t("nav.mainLabel")}
  >
    <!-- Navbar Start: Burger menu (mobile) + Name -->
    <div class="navbar-start">
      <details class="dropdown lg:hidden">
        <summary
          class="btn btn-ghost btn-circle"
          aria-label={t("nav.toggleMenu")}
        >
          <MenuIcon />
        </summary>
        <ul class="dropdown-content menu menu-sm bg-base-200 text-base-content rounded-box w-36 p-2 shadow-2xl border border-base-content/10 z-50">
          <li class="menu-title text-xs">{t("nav.title")}</li>
          {NAV_LINKS.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </details>
      <a
        href={homeUrl}
        class="lg:text-xl font-bold ml-2 lg:ml-0 group flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-primary/70 group-hover:scale-125 transition-transform"></span>
        <span>{t("home.name")}</span>
      </a>
    </div>

    <!-- Navbar Center: Navigation links (desktop) -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-medium px-3 py-1.5 rounded-full hover:bg-base-content/10 hover:text-primary transition-all duration-200"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Navbar End: Theme and Language selectors -->
    <div class="navbar-end items-center gap-1">
      <a
        href={getRelativeLocaleUrl(lang, "search")}
        class="btn btn-ghost btn-sm h-10 gap-1.5 rounded-full"
        aria-label={c.search}
        aria-keyshortcuts="Control+k Meta+k"
      >
        <SearchIcon class="block size-4 shrink-0" aria-hidden="true" />
        <span class="hidden xl:inline">{c.search}</span>
      </a>
      <LanguageController />
      <ThemeController />
    </div>

    <!-- Dynamic Reading Progress Bar at the bottom of the pill -->
    <div
      id="header-progress"
      class="absolute bottom-0 inset-x-8 h-[2px] bg-base-content/10 rounded-full overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300"
      aria-hidden="true"
    >
      <div
        id="header-progress-bar"
        class="h-full bg-gradient-to-r from-primary via-accent to-secondary w-0 transition-[width] duration-75"
      ></div>
    </div>
  </nav>
</header>
