---
import { serializeJsonLd } from "../utils/serialize";
import { SITE } from "../config/site";
import { resolveSEOData } from "../utils/seo";
import { locales } from "../i18n/ui";
import meImage from "../assets/images/me.webp";

export interface Props {
  author?: string;
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  structuredDataType?: "profile" | "collection";
  wordCount?: number;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  type = "website",
  publishDate,
  updatedDate,
  tags,
  structuredDataType,
  wordCount,
  faq,
} = Astro.props;

const { lang } = Astro.locals;
const slug = Astro.params.slug;

const seo = resolveSEOData(Astro.props, Astro.url, lang, slug);
const t = seo.t;

// Schemas list
const schemas: Record<string, unknown>[] = [];

// 1. BreadcrumbList for all pages
const segments = seo.pathname.split("/").filter(Boolean);
let breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: t("nav.home"),
    item: `${seo.cleanSiteUrl}/${seo.lang}/`,
  },
];

if (segments.length > 1) {
  // We are on a subpage (e.g. /en/blog or /en/projects)
  const categorySegment = segments[1];
  if (categorySegment === "blog") {
    breadcrumbItems.push({
      "@type": "ListItem",
      position: 2,
      name: t("nav.blog"),
      item: `${seo.cleanSiteUrl}/${seo.lang}/blog/`,
    });

    if (segments.length > 2) {
      // Individual blog post
      breadcrumbItems.push({
        "@type": "ListItem",
        position: 3,
        name: seo.title,
        item: seo.canonicalUrl,
      });
    }
  } else if (categorySegment === "projects" || categorySegment === "uses") {
    breadcrumbItems.push({
      "@type": "ListItem",
      position: 2,
      name: categorySegment === "uses" ? t("nav.uses") : t("nav.projects"),
      item: `${seo.cleanSiteUrl}/${seo.lang}/${categorySegment}/`,
    });
  }
}

schemas.push({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
});

// 2. WebSite schema (Only on Home)
if (seo.isHome) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${seo.cleanSiteUrl}/#website`,
    name: t("home.name") || SITE.name,
    url: seo.cleanSiteUrl,
    inLanguage: locales,
  });
}

// 3. ProfilePage + Person schema (Only on Home or if structuredDataType === "profile")
if (seo.isHome || structuredDataType === "profile") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
      "@type": "Person",
      "@id": `${seo.cleanSiteUrl}/#person`,
      name: SITE.name,
      jobTitle: "Full Stack Software Developer",
      url: `${seo.cleanSiteUrl}/${seo.lang}/`,
      email: SITE.email,
      image: new URL(meImage.src, seo.cleanSiteUrl).href,
      sameAs: [SITE.social.github, SITE.social.linkedin],
      knowsLanguage: ["es", "en"],
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universidad Mayor de San Simón",
      },
    },
  });
}

// 4. CollectionPage schema (For blog index or projects index)
if (seo.isBlogIndex || seo.isProjects || structuredDataType === "collection") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: seo.title,
    description: seo.description,
    url: seo.canonicalUrl,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${seo.cleanSiteUrl}/#website`,
      name: SITE.name,
      url: seo.cleanSiteUrl,
    },
  });
}

// 5. BlogPosting schema (For individual blog post)
if (type === "article") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: Astro.props.title || seo.title,
    description: seo.description,
    image: seo.imageUrl,
    datePublished: publishDate ? publishDate.toISOString() : undefined,
    dateModified: updatedDate
      ? updatedDate.toISOString()
      : publishDate
        ? publishDate.toISOString()
        : undefined,
    author: {
      "@type": "Person",
      "@id":
        !Astro.props.author || Astro.props.author === SITE.name
          ? `${seo.cleanSiteUrl}/#person`
          : undefined,
      name: Astro.props.author || SITE.name,
      url: `${seo.cleanSiteUrl}/${seo.lang}/`,
      sameAs: [SITE.social.github, SITE.social.linkedin],
    },
    publisher: {
      "@type": "Person",
      "@id": `${seo.cleanSiteUrl}/#person`,
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: `${seo.cleanSiteUrl}/favicon.svg`,
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": seo.canonicalUrl,
    },
    wordCount: wordCount,
    articleSection: "Technology",
    keywords: tags || [],
    inLanguage: seo.lang,
  });
}

// 6. FAQPage schema (If post has FAQ data)
if (faq && faq.length > 0) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}
---

{schemas.map((schema) => (
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(schema)}
  />
))}
