---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
  id?: string;
  label: string;
}
const { headings, id, label } = Astro.props;
let section = 0;
const items = headings.map((heading) => ({
  ...heading,
  number: heading.depth === 2 ? String(++section).padStart(2, "0") : "",
  label: heading.text.replace(/^[^\p{L}\p{N}]+/u, ""),
}));
---

<nav id={id} aria-label={label} class="contents-list">
  <ol>
    {items.map((item) => (
      <li class:list={{ "contents-subsection": item.depth === 3 }}>
        <a href={`#${item.slug}`} class="contents-link">
          <span class="contents-number" aria-hidden="true">
            {item.number}
          </span>
          <span class="contents-label">{item.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-top: 1px solid
      color-mix(in oklch, var(--color-base-content) 12%, transparent);
  }
  .contents-link {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 1.05rem 0;
    color: var(--color-base-content);
    line-height: 1.5;
    align-items: baseline;
  }
  .contents-number {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0.45;
    font-variant-numeric: tabular-nums;
  }
  .contents-label {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .contents-subsection {
    border: 0;
  }
  .contents-subsection .contents-link {
    padding: 0.35rem 0 0.65rem;
  }
  .contents-subsection .contents-label {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .contents-link:hover .contents-label {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .contents-link:global(.toc-active) .contents-number {
    opacity: 1;
    color: var(--color-primary);
  }
  .contents-link:global(.toc-active) .contents-label {
    font-weight: 650;
  }
  .contents-link:global(.toc-active) {
    box-shadow: inset 2px 0 var(--color-primary);
    padding-left: 0.7rem;
  }
</style>
