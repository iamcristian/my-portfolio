---
---

<div
  id="reading-progress"
  class="fixed top-0 left-0 h-0.5 z-50 transition-all duration-75 pointer-events-none bg-linear-to-r from-base-content/20 via-base-content/60 to-base-content shadow-[0_0_10px_rgba(255,255,255,0.4)]"
  style="width: 0%;"
>
  <span
    class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-base-content shadow-[0_0_8px_2px_rgba(255,255,255,0.75)]"
    aria-hidden="true"
  ></span>
</div>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const progressBar = document.getElementById("reading-progress");
    const article = document.querySelector("article.prose");

    if (!progressBar || !article) return;

    const updateProgressBar = () => {
      const rect = article.getBoundingClientRect();
      const totalHeight = rect.height;
      const scrolled = -rect.top;
      const viewportHeight = window.innerHeight;

      // The article reading is completed when the bottom of the article is in view
      const scrollableHeight = totalHeight - viewportHeight;

      if (scrollableHeight <= 0) {
        progressBar.style.width = rect.bottom <= viewportHeight ? "100%" : "0%";
        return;
      }

      let progress = (scrolled / scrollableHeight) * 100;
      progress = Math.max(0, Math.min(100, progress));
      progressBar.style.width = `${progress}%`;
    };

    window.addEventListener("scroll", updateProgressBar, {
      passive: true,
      signal,
    });
    window.addEventListener("resize", updateProgressBar, {
      passive: true,
      signal,
    });
    updateProgressBar();
  });
</script>
