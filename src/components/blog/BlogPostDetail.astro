---
import { isPublished } from "@utils/blog";
import type { CollectionEntry } from "astro:content";
import { render, getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import { getReadTime } from "@utils/blog";
import { Image } from "astro:assets";
import ContentsList from "./ContentsList.astro";
import ReaderTools from "./ReaderTools.astro";
import SeriesNavigation from "./SeriesNavigation.astro";
import { featureCopy } from "../../i18n/features";
import Giscus from "./Giscus.astro";
import ShareButtons from "./ShareButtons.astro";
import BlogCard from "@components/ui/cards/BlogCard.astro";

// SVGs
import CalendarIcon from "@assets/icons/calendar.svg";
import ClockIcon from "@assets/icons/clock.svg";
import ListIcon from "@assets/icons/list.svg";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { lang } = Astro.locals;
const langCode = lang;
const t = useTranslations(langCode);
const c = featureCopy(lang);

// Render markdown content and retrieve headings
const { Content, headings } = await render(post);

// Filter headings to show only h2 and h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Fetch sibling posts in the same language for bottom navigation
const langPosts = (
  await getCollection(
    "blog",
    ({ data }) => data.lang === lang && isPublished(data),
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Calculate related posts based on matching tags
const currentTags = new Set(post.data.tags);
const relatedPosts = langPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags.some((tag) => currentTags.has(tag)))
  .slice(0, 3);

// Fallback to latest posts if no matching tags found
const finalRelatedPosts =
  relatedPosts.length > 0
    ? relatedPosts
    : langPosts.filter((p) => p.id !== post.id).slice(0, 3);

const formattedDate = new Intl.DateTimeFormat(lang, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(post.data.date);
---

<main
  id="main-content"
  class="max-w-6xl mx-auto px-4 md:px-8 pt-8 md:pt-12 pb-16 md:pb-24 min-h-screen"
>
  <!-- Back to Blog Button -->
  <div class="mb-6 md:mb-8">
    <a
      href={getRelativeLocaleUrl(lang, "blog")}
      class="btn btn-ghost btn-sm gap-2"
    >
      &larr; {t("blog.back")}
    </a>
  </div>

  <!-- Article Header -->
  <header class="max-w-3xl space-y-4">
    <div class="flex flex-wrap gap-1.5">
      {post.data.tags.map((tag) => (
        <span class="badge badge-xs font-mono bg-base-300/50 border border-base-content/10 text-base-content/80 hover:text-primary transition-colors py-2 px-2">
          {tag}
        </span>
      ))}
    </div>
    <h1 class="text-xl md:text-3xl font-extrabold tracking-tight leading-tight">
      {post.data.title}
    </h1>
    <div class="flex items-center justify-between flex-wrap gap-4 pt-2 border-b border-base-300 pb-4">
      <div class="flex items-center gap-4 text-xs text-base-content/80">
        <span class="flex items-center gap-1">
          <CalendarIcon class="w-4 h-4" />
          <span>
            {t("blog.published")} {formattedDate}
          </span>
        </span>
        <span class="flex items-center gap-1">
          <ClockIcon class="w-4 h-4" />
          <span>
            {getReadTime(post.body, post.data.lang)} {t("blog.readTime")}
          </span>
        </span>
      </div>
      <ShareButtons title={post.data.title} />
    </div>
  </header>

  <ReaderTools title={post.data.title} />
  {post.data.updatedDate && (
    <p class="text-sm mb-4">
      {c.updated}:{" "}
      {new Intl.DateTimeFormat(lang, {
        dateStyle: "long",
        timeZone: "UTC",
      }).format(post.data.updatedDate)}
    </p>
  )}
  {(post.data.revisions?.length ||
    post.data.versions ||
    post.data.examplesChecked) && (
    <details class="collapse collapse-arrow bg-base-200 mb-6">
      <summary class="collapse-title font-medium">{c.revisions}</summary>
      <div class="collapse-content space-y-2">
        {post.data.versions && (
          <p>
            {c.versions}: {post.data.versions}
          </p>
        )}
        {post.data.examplesChecked && (
          <p>
            {c.checked}: {post.data.examplesChecked}
          </p>
        )}
        <ul>
          {post.data.revisions?.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </div>
    </details>
  )}
  <!-- Content Layout Grid -->
  <div
    id="article-grid"
    class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-12 items-start"
  >
    <!-- Left Column: Markdown Content -->
    <div class="flex flex-col gap-6">
      {post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 768px, calc(100vw - 32px)"
          width={1200}
          height={514}
          loading="eager"
          fetchpriority="high"
          class="w-full object-cover aspect-21/9 max-h-75 rounded-xl border border-base-300 shadow-md"
        />
      )}
      <article class="reader-article prose max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
        <Content />
      </article>
      {post.data.faq && post.data.faq.length > 0 && (
        <section class="prose prose-sm max-w-none" aria-label="FAQ">
          <h2>FAQ</h2>
          {post.data.faq.map((item) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </section>
      )}
      <SeriesNavigation slug={post.data.slug} />
      <Giscus />
    </div>

    <!-- Right Column: Sidebar Table of Contents (Desktop only) -->
    {tocHeadings.length > 0 && (
      <aside id="article-toc" class="hidden lg:block sticky top-24">
        <div class="border-t border-base-content/20 pt-5">
          <h2 class="text-xs uppercase tracking-[.16em] opacity-60 mb-5">
            {c.contents}
          </h2>
          <ContentsList
            id="desktop-toc"
            headings={tocHeadings}
            label={t("blog.toc")}
          />
        </div>
      </aside>
    )}
  </div>

  <!-- Mobile TOC Floating Action Button (FAB) and Dialog Modal -->
  {tocHeadings.length > 0 && (
    <>
      <button
        id="toc-fab"
        class="btn btn-circle btn-primary fixed bottom-6 right-6 lg:hidden shadow-lg z-40"
        aria-controls="toc_modal"
        aria-haspopup="dialog"
        aria-label={t("blog.toc")}
      >
        <ListIcon class="w-5 h-5" />
      </button>

      <dialog
        aria-labelledby="toc-title"
        id="toc_modal"
        class="modal toc-modal"
      >
        <div class="modal-box toc-paper bg-base-100 text-base-content">
          <div class="flex justify-between items-center gap-4 mb-8">
            <span class="text-[10px] uppercase tracking-[.2em] opacity-50">
              {getReadTime(post.body, post.data.lang)} {t("blog.readTime")}
            </span>
            <form method="dialog">
              <button
                class="btn btn-ghost btn-circle btn-sm"
                aria-label={t("blog.close")}
              >
                <span aria-hidden="true">✕</span>
              </button>
            </form>
          </div>
          <h2 id="toc-title" class="font-serif text-3xl tracking-tight mb-3">
            {c.contents}
          </h2>
          <p class="text-xs leading-relaxed opacity-55 mb-8">
            {post.data.title}
          </p>
          <ContentsList headings={tocHeadings} label={t("blog.toc")} />
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>{t("blog.close")}</button>
        </form>
      </dialog>
    </>
  )}

  <!-- Related Posts Section -->
  {finalRelatedPosts.length > 0 && (
    <div id="related-articles" class="mt-16 pt-8 border-t border-base-300">
      <h2 class="text-lg md:text-xl font-bold mb-6">
        {t("blog.relatedPosts") || "Related Articles"}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {finalRelatedPosts.map((rPost) => (
          <BlogCard post={rPost} />
        ))}
      </div>
    </div>
  )}
</main>

<style>
  .toc-modal {
    justify-items: end;
    padding: 0;
  }
  .toc-modal .toc-paper {
    width: min(26rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    border-radius: 0;
    margin: 0;
    padding: 2rem;
    overflow-y: auto;
    border-left: 1px solid
      color-mix(in oklch, var(--color-base-content) 15%, transparent);
    box-shadow: -12px 0 48px #0002;
  }
  @media (max-width: 480px) {
    .toc-modal .toc-paper {
      padding: 1.5rem;
      width: calc(100vw - 1rem);
    }
  }
</style>

<script>
  import { onPageLoad, scrollBehavior } from "../../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const dialog = document.querySelector<HTMLDialogElement>("#toc_modal");
    document
      .getElementById("toc-fab")
      ?.addEventListener("click", () => dialog?.showModal(), { signal });
    dialog?.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
      link.addEventListener(
        "click",
        (event) => {
          const target = document.getElementById(
            decodeURIComponent(link.hash.slice(1)),
          );
          if (!target) return;
          event.preventDefault();
          dialog.close();
          history.replaceState(history.state, "", link.hash);
          target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
          target.scrollIntoView({ behavior: scrollBehavior() });
        },
        { signal },
      );
    });
    const article = document.querySelector("article.prose");
    if (!article) return;
    const headings = Array.from(article.querySelectorAll("h2, h3"));
    const allTocLinks = document.querySelectorAll(
      "#desktop-toc a, #toc_modal nav a",
    );

    if (headings.length === 0 || allTocLinks.length === 0) return;

    // Track intersection state of each heading by its ID
    const headingStates = new Map();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          headingStates.set(entry.target.id, entry.isIntersecting);
        });

        // Determine which heading is active
        // 1. Get all currently intersecting headings
        const intersectingHeadings = headings.filter((h) =>
          headingStates.get(h.id),
        );

        let activeId = null;

        if (intersectingHeadings.length > 0) {
          // If there are intersecting headings, the first one in document order is active
          activeId = intersectingHeadings[0].id;
        } else {
          // If none are intersecting, find the last one that is above the viewport
          // (i.e., we have scrolled past it)
          const scrolledPast = headings.filter((h) => {
            const rect = h.getBoundingClientRect();
            return rect.top < 100; // Matches the top margin offset
          });
          if (scrolledPast.length > 0) {
            activeId = scrolledPast[scrolledPast.length - 1].id;
          }
        }

        // Update the active classes
        if (activeId) {
          allTocLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === `#${activeId}`) {
              link.classList.add("toc-active");
              link.setAttribute("aria-current", "location");
            } else {
              link.classList.remove("toc-active");
              link.removeAttribute("aria-current");
            }
          });
        }
      },
      { rootMargin: "-95px 0px -70% 0px", threshold: 0 },
    );

    headings.forEach((heading) => observer.observe(heading));
    return () => observer.disconnect();
  });
</script>
