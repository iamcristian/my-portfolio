---
import { isPublished } from "@utils/blog";
import { useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";
import BlogCard from "../ui/cards/BlogCard.astro";
import PageHeading from "../ui/PageHeading.astro";
import ListControls from "../ui/ListControls.astro";
import ListFooter from "../ui/ListFooter.astro";
import { sortFeaturedFirst } from "../../utils/sort";

const { lang: langCode } = Astro.locals;
const t = useTranslations(langCode);

const rawPosts = await getCollection("blog", ({ data }) => {
  return data.lang === langCode && isPublished(data);
});

const blogPosts = sortFeaturedFirst(
  rawPosts,
  (p) => p.data.featured,
  (p) => p.data.date,
);

// Order tags by frequency so the primary filter bar surfaces the most active topics
const tagCounts = new Map<string, number>();
for (const post of blogPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const allTags = Array.from(tagCounts.keys()).sort(
  (a, b) => (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0),
);
const primaryTags = allTags.slice(0, 7);
const overflowTags = allTags.slice(7);
---

<main
  id="main-content"
  class="max-w-6xl mx-auto px-4 md:px-8 pt-8 md:pt-12 pb-16 md:pb-24 flex flex-col gap-8 min-h-screen"
>
  <PageHeading
    subtitle={t("blog.subtitle")}
    title={t("blog.title")}
    description={t("blog.subtitlePage")}
  />

  <ListControls
    searchInputId="blog-search"
    searchPlaceholder={t("blog.searchPlaceholder")}
    dateRangeSelectId="blog-date-range"
    customDateContainerId="blog-custom-date-container"
    startDateInputId="blog-start-date"
    endDateInputId="blog-end-date"
    dateErrorId="blog-date-error"
    sortSelectId="blog-sort"
  >
    <div
      slot="filters"
      class="flex flex-wrap gap-1.5 justify-center md:justify-start max-w-xl"
      id="tag-filters"
    >
      <button
        type="button"
        class="btn btn-xs btn-neutral tag-btn active"
        aria-pressed="true"
        data-tag="all"
      >
        {t("projects.all")}
      </button>
      {primaryTags.map((tag) => (
        <button
          type="button"
          class="btn btn-xs btn-outline tag-btn"
          aria-pressed="false"
          data-tag={tag}
        >
          {tag}
        </button>
      ))}
      {overflowTags.length > 0 && (
        <details class="inline-flex flex-wrap gap-1.5 items-center">
          <summary class="btn btn-xs btn-ghost list-none cursor-pointer">
            +{overflowTags.length} {t("blog.moreTags")}
          </summary>
          <div class="flex flex-wrap gap-1.5 pt-1.5 w-full">
            {overflowTags.map((tag) => (
              <button
                type="button"
                class="btn btn-xs btn-outline tag-btn"
                aria-pressed="false"
                data-tag={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </details>
      )}
    </div>
  </ListControls>

  <div
    id="blog-container"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 min-h-75"
  >
    {blogPosts.map((post, index) => (
      <BlogCard
        headingLevel="h2"
        post={post}
        showFeaturedBadge={post.data.featured}
        loading={index < 3 ? "eager" : "lazy"}
        data-id={post.id}
        data-featured={post.data.featured ? "true" : "false"}
        data-date={post.data.date.toISOString()}
        data-name={post.data.title.toLowerCase()}
        data-tags={JSON.stringify(
          post.data.tags.map((tag) => tag.toLowerCase()),
        )}
        data-description={post.data.description.toLowerCase()}
      />
    ))}
  </div>

  <ListFooter noResultsText={t("blog.noResults")} />
</main>

<script>
  import { initListManager } from "../../scripts/list-manager";
  import { onPageLoad } from "../../scripts/page-lifecycle";
  import { getListViewClasses } from "../../utils/list";

  onPageLoad((signal) => {
    initListManager(
      {
        containerId: "blog-container",
        cardSelector: ".blog-card",
        searchInputId: "blog-search",
        sortSelectId: "blog-sort",
        filterBtnSelector: "#tag-filters .tag-btn",
        filterAttr: "data-tags",
        gridBtnId: "view-grid-btn",
        listBtnId: "view-list-btn",
        noResultsId: "no-results-state",
        paginationId: "pagination-controls",
        itemsPerPage: 10,
        hasFeatured: true,
        dateRangeSelectId: "blog-date-range",
        customDateContainerId: "blog-custom-date-container",
        startDateInputId: "blog-start-date",
        endDateInputId: "blog-end-date",
        dateErrorId: "blog-date-error",
        figureSelector: ".blog-figure",
        bodySelector: ".blog-body",
        footerSelector: ".blog-footer",
        ...getListViewClasses("blog"),
      },
      signal,
    );
  });
</script>
