---
import { isPublished } from "@utils/blog";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import BlogCard from "../ui/cards/BlogCard.astro";
import ChevronLeftIcon from "../../assets/icons/chevron-left.svg";
import ChevronRightIcon from "../../assets/icons/chevron-right.svg";
import SectionHeading from "../ui/SectionHeading.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

// Fetch Blog Posts from Content Collection
const blogPosts = await getCollection("blog", ({ data }) => {
  return data.lang === lang && isPublished(data);
});

// Sort by date descending
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// All featured posts (from frontmatter "featured: true")
const featuredBlogPosts = sortedPosts.filter((p) => p.data.featured);
// Fall back to latest post if no featured posts are defined
if (featuredBlogPosts.length === 0 && sortedPosts.length > 0) {
  featuredBlogPosts.push(sortedPosts[0]);
}

// Recent posts excluding the featured ones, up to 3 cards
const featuredIds = new Set(featuredBlogPosts.map((p) => p.id));
const recentBlogPosts = sortedPosts
  .filter((p) => !featuredIds.has(p.id))
  .slice(0, 3);
---

<section
  id="blog"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal"
>
  <SectionHeading subtitle={t("blog.subtitle")} title={t("blog.title")} />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {featuredBlogPosts.length > 0 && (
      <div class="md:col-span-3 relative group">
        <div
          class="carousel w-full rounded-2xl scroll-smooth"
          id="featured-carousel"
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label={t("blog.featured")}
        >
          {featuredBlogPosts.map((post, index) => (
            <div
              id={`featured-slide-${index}`}
              class="carousel-item relative w-full"
            >
              <div class="w-full py-4 px-2">
                <BlogCard post={post} isFeatured={true} />
              </div>
            </div>
          ))}
        </div>

        {featuredBlogPosts.length > 1 && (
          <button
            class="carousel-pause btn btn-sm btn-ghost mt-2"
            aria-pressed="true"
            data-pause={t("accessibility.pause")}
            data-play={t("accessibility.play")}
          >
            {t("accessibility.play")}
          </button>
        )}
        {featuredBlogPosts.length > 1 && (
          <>
            <button
              class="carousel-prev btn btn-circle btn-sm md:btn-md bg-base-100 hover:bg-base-200 text-base-content border border-base-300 shadow-md absolute -left-4 md:-left-5 top-1/2 -translate-y-1/2 z-10 transition-transform hover:scale-105 duration-200"
              aria-label={t("accessibility.previousPage")}
            >
              <ChevronLeftIcon class="w-4 h-4 md:w-5 md:h-5" />
            </button>
            <button
              class="carousel-next btn btn-circle btn-sm md:btn-md bg-base-100 hover:bg-base-200 text-base-content border border-base-300 shadow-md absolute -right-4 md:-right-5 top-1/2 -translate-y-1/2 z-10 transition-transform hover:scale-105 duration-200"
              aria-label={t("accessibility.nextPage")}
            >
              <ChevronRightIcon class="w-4 h-4 md:w-5 md:h-5" />
            </button>
          </>
        )}
      </div>
    )}

    {recentBlogPosts.map((post) => (
      <BlogCard post={post} />
    ))}
  </div>

  <div class="text-center mt-10">
    <a
      href={getRelativeLocaleUrl(lang, "blog")}
      class="btn btn-ghost border border-base-content/10 hover:border-primary/30 group"
    >
      {t("blog.viewAll")}{" "}
      <span class="group-hover:translate-x-1 transition-transform inline-block ml-1">
        &rarr;
      </span>
    </a>
  </div>
</section>

<script>
  import { onPageLoad, scrollBehavior } from "../../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const carousel = document.getElementById("featured-carousel");
    if (!carousel) return;
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>(".carousel-item"),
    );
    const parent = carousel.parentElement!;
    const pause = parent.querySelector<HTMLButtonElement>(".carousel-pause");
    if (slides.length <= 1 || !pause) return;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let paused = motion.matches;
    let hovered = false;
    let focused = false;
    let interval: ReturnType<typeof setInterval> | undefined;
    const move = (delta: number) => {
      const index = Math.round(carousel.scrollLeft / carousel.clientWidth);
      const next = (index + delta + slides.length) % slides.length;
      carousel.scrollTo({
        left: next * carousel.clientWidth,
        behavior: scrollBehavior(),
      });
    };
    const sync = () => {
      clearInterval(interval);
      pause.textContent = paused ? pause.dataset.play! : pause.dataset.pause!;
      pause.setAttribute("aria-pressed", String(paused));
      if (!paused && !hovered && !focused && !document.hidden)
        interval = setInterval(() => move(1), 5000);
    };
    parent.querySelector(".carousel-prev")?.addEventListener(
      "click",
      () => {
        paused = true;
        move(-1);
        sync();
      },
      { signal },
    );
    parent.querySelector(".carousel-next")?.addEventListener(
      "click",
      () => {
        paused = true;
        move(1);
        sync();
      },
      { signal },
    );
    pause.addEventListener(
      "click",
      () => {
        paused = !paused;
        sync();
      },
      { signal },
    );
    parent.addEventListener(
      "mouseenter",
      () => {
        hovered = true;
        sync();
      },
      { signal },
    );
    parent.addEventListener(
      "mouseleave",
      () => {
        hovered = false;
        sync();
      },
      { signal },
    );
    parent.addEventListener(
      "focusin",
      () => {
        focused = true;
        sync();
      },
      { signal },
    );
    parent.addEventListener(
      "focusout",
      (event) => {
        focused = parent.contains(event.relatedTarget as Node);
        sync();
      },
      { signal },
    );
    carousel.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          paused = true;
          move(event.key === "ArrowLeft" ? -1 : 1);
          sync();
        }
      },
      { signal },
    );
    carousel.addEventListener(
      "focusin",
      (event) => {
        (event.target as HTMLElement)
          .closest<HTMLElement>(".carousel-item")
          ?.scrollIntoView({
            block: "nearest",
            inline: "start",
            behavior: scrollBehavior(),
          });
      },
      { signal },
    );
    motion.addEventListener(
      "change",
      () => {
        if (motion.matches) paused = true;
        sync();
      },
      { signal },
    );
    document.addEventListener("visibilitychange", sync, { signal });
    sync();
    return () => clearInterval(interval);
  });
</script>
