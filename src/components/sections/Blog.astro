---
import { isPublished } from "@utils/blog";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import BlogCard from "../ui/cards/BlogCard.astro";
import ChevronLeftIcon from "../../assets/icons/chevron-left.svg";
import ChevronRightIcon from "../../assets/icons/chevron-right.svg";
import SectionHeading from "../ui/SectionHeading.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

// Fetch Blog Posts from Content Collection
const blogPosts = await getCollection("blog", ({ data }) => {
  return data.lang === lang && isPublished(data);
});

// Sort by date descending
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// All featured posts (from frontmatter "featured: true")
const featuredBlogPosts = sortedPosts.filter((p) => p.data.featured);
// Fall back to latest post if no featured posts are defined
if (featuredBlogPosts.length === 0 && sortedPosts.length > 0) {
  featuredBlogPosts.push(sortedPosts[0]);
}

// Recent posts excluding the featured ones, up to 3 cards
const featuredIds = new Set(featuredBlogPosts.map((p) => p.id));
const recentBlogPosts = sortedPosts
  .filter((p) => !featuredIds.has(p.id))
  .slice(0, 3);
---

<section
  id="blog"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal"
>
  <SectionHeading subtitle={t("blog.subtitle")} title={t("blog.title")} />

  <div class="space-y-8">
    {featuredBlogPosts.length > 0 && (
      <div class="relative group/carousel">
        {featuredBlogPosts.length > 1 && (
          <div class="flex items-center justify-between pb-3 text-xs border-b border-base-300/40 mb-1">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
              </span>
              <span class="font-mono text-xs uppercase tracking-wider text-base-content font-semibold">
                {t("blog.featured")}
              </span>
              <span class="text-base-content font-mono" aria-hidden="true">/</span>
              <span
                class="font-mono text-xs text-base-content"
                id="carousel-counter"
                aria-live="polite"
              >
                01 / {String(featuredBlogPosts.length).padStart(2, "0")}
              </span>
            </div>

            <div class="flex items-center gap-3">
              <!-- Indicators / Pills -->
              <div
                class="hidden sm:flex items-center gap-1"
                aria-label={t("blog.featured")}
              >
                {featuredBlogPosts.map((post, idx) => (
                  <button
                    type="button"
                    class="carousel-indicator flex items-center justify-center min-w-6 h-7 px-1 rounded cursor-pointer transition-colors hover:bg-base-300/40 focus-visible:outline-2 focus-visible:outline-primary"
                    data-slide-index={idx}
                    aria-label={`Slide ${idx + 1}: ${post.data.title}`}
                    aria-current={idx === 0 ? "true" : "false"}
                  >
                    <span
                      class="carousel-indicator-bar h-1.5 rounded-full transition-all duration-300 block"
                      style={
                        idx === 0
                          ? "width: 1.5rem; background-color: var(--color-primary);"
                          : "width: 0.5rem; background-color: var(--color-base-content); opacity: 0.4;"
                      }
                    />
                  </button>
                ))}
              </div>

              <div class="h-3 w-px bg-base-300 hidden sm:block"></div>

              <!-- Controls Group: Prev/Next -->
              <div class="flex items-center gap-1">
                <button
                  type="button"
                  class="carousel-prev btn btn-xs btn-ghost border border-base-300 hover:border-primary/40 text-base-content hover:text-primary transition-colors p-0 w-7 h-7 rounded"
                  aria-label={t("accessibility.previousPage")}
                  title={t("accessibility.previousPage")}
                >
                  <ChevronLeftIcon class="w-3.5 h-3.5" />
                </button>
                <button
                  type="button"
                  class="carousel-next btn btn-xs btn-ghost border border-base-300 hover:border-primary/40 text-base-content hover:text-primary transition-colors p-0 w-7 h-7 rounded"
                  aria-label={t("accessibility.nextPage")}
                  title={t("accessibility.nextPage")}
                >
                  <ChevronRightIcon class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
          </div>
        )}

        <div
          class="carousel w-full rounded scroll-smooth pt-1 pb-2"
          id="featured-carousel"
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label={t("blog.featured")}
        >
          {featuredBlogPosts.map((post, index) => (
            <div
              id={`featured-slide-${index}`}
              class="carousel-item relative w-full h-full"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${featuredBlogPosts.length}: ${post.data.title}`}
            >
              <div class="w-full h-full">
                <BlogCard post={post} isFeatured={true} class="h-full" />
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {recentBlogPosts.length > 0 && (
      <div
        class:list={[
          "grid grid-cols-1 gap-6",
          recentBlogPosts.length === 1 && "max-w-xl mx-auto",
          recentBlogPosts.length === 2 && "md:grid-cols-2",
          recentBlogPosts.length >= 3 && "md:grid-cols-3",
        ]}
      >
        {recentBlogPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    )}
  </div>

  <div class="text-center mt-10">
    <a
      href={getRelativeLocaleUrl(lang, "blog")}
      class="btn btn-ghost border border-base-content/10 hover:border-primary/30 group"
    >
      {t("blog.viewAll")}{" "}
      <span class="group-hover:translate-x-1 transition-transform inline-block ml-1">
        &rarr;
      </span>
    </a>
  </div>
</section>

<script>
  import { onPageLoad, scrollBehavior } from "../../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const carousel = document.getElementById("featured-carousel");
    if (!carousel) return;
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>(".carousel-item"),
    );
    const parent =
      carousel.closest(".group\\/carousel") || carousel.parentElement!;
    const counter = parent.querySelector<HTMLElement>("#carousel-counter");
    const indicators = Array.from(
      parent.querySelectorAll<HTMLButtonElement>(".carousel-indicator"),
    );

    if (slides.length <= 1) return;

    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let hovered = false;
    let focused = false;
    let interval: ReturnType<typeof setInterval> | undefined;

    const updateUI = (index: number) => {
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      }
      indicators.forEach((btn, idx) => {
        const isActive = idx === index;
        btn.setAttribute("aria-current", String(isActive));
        const bar = btn.querySelector<HTMLElement>(".carousel-indicator-bar");
        if (bar) {
          if (isActive) {
            bar.style.width = "1.5rem";
            bar.style.backgroundColor = "var(--color-primary)";
            bar.style.opacity = "1";
          } else {
            bar.style.width = "0.5rem";
            bar.style.backgroundColor = "var(--color-base-content)";
            bar.style.opacity = "0.4";
          }
        }
      });
    };

    const resetTimer = () => {
      clearInterval(interval);
      if (!motion.matches && !hovered && !focused && !document.hidden) {
        interval = setInterval(() => move(1), 5000);
      }
    };

    const goTo = (index: number) => {
      carousel.scrollTo({
        left: index * carousel.clientWidth,
        behavior: scrollBehavior(),
      });
      updateUI(index);
      resetTimer();
    };

    const move = (delta: number) => {
      const index = Math.round(carousel.scrollLeft / carousel.clientWidth);
      const next = (index + delta + slides.length) % slides.length;
      goTo(next);
    };

    parent.querySelector(".carousel-prev")?.addEventListener(
      "click",
      () => {
        move(-1);
      },
      { signal },
    );

    parent.querySelector(".carousel-next")?.addEventListener(
      "click",
      () => {
        move(1);
      },
      { signal },
    );

    indicators.forEach((btn, idx) => {
      btn.addEventListener(
        "click",
        () => {
          goTo(idx);
        },
        { signal },
      );
    });

    parent.addEventListener(
      "mouseenter",
      () => {
        hovered = true;
        resetTimer();
      },
      { signal },
    );
    parent.addEventListener(
      "mouseleave",
      () => {
        hovered = false;
        resetTimer();
      },
      { signal },
    );
    parent.addEventListener(
      "focusin",
      () => {
        focused = true;
        resetTimer();
      },
      { signal },
    );
    parent.addEventListener(
      "focusout",
      (event) => {
        focused = parent.contains((event as FocusEvent).relatedTarget as Node);
        resetTimer();
      },
      { signal },
    );

    carousel.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          move(event.key === "ArrowLeft" ? -1 : 1);
        }
      },
      { signal },
    );

    carousel.addEventListener(
      "focusin",
      (event) => {
        (event.target as HTMLElement)
          .closest<HTMLElement>(".carousel-item")
          ?.scrollIntoView({
            block: "nearest",
            inline: "start",
            behavior: scrollBehavior(),
          });
      },
      { signal },
    );

    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
    carousel.addEventListener(
      "scroll",
      () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const index = Math.round(carousel.scrollLeft / carousel.clientWidth);
          updateUI(index);
          resetTimer();
        }, 50);
      },
      { signal, passive: true },
    );

    motion.addEventListener(
      "change",
      () => {
        resetTimer();
      },
      { signal },
    );

    document.addEventListener("visibilitychange", resetTimer, { signal });
    resetTimer();
    return () => clearInterval(interval);
  });
</script>
