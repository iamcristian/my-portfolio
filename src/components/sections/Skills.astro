---

<section
  id="skills"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal relative"
>
  <SectionHeading subtitle={t("skills.subtitle")} title={t("skills.title")} />

  <!-- Monochromatic Celestial Constellation Sector Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {skillsCategories.map((category) => {
      const constellation =
        CONSTELLATIONS[category.id] || CONSTELLATIONS.languages;
      const anchorStar = constellation.stars[constellation.anchorIndex];

      return (
        <div
          id={`skills-${category.id}`}
          tabindex={-1}
          data-spotlight="true"
          class="skill-card scroll-mt-24 group relative card bg-base-200/45 backdrop-blur-md border border-base-content/10 p-6 rounded-2xl transition-all duration-500 hover:border-base-content/30 hover:-translate-y-1 overflow-hidden flex flex-col justify-between"
        >
          {/* Ambient Starlight Glow on Hover */}
          <div
            class="absolute -top-12 -right-12 w-44 h-44 rounded-full pointer-events-none opacity-20 group-hover:opacity-65 transition-opacity duration-500 blur-2xl bg-base-content/10"
            aria-hidden="true"
          />

          {/* Real Unique Astronomical Constellation SVG in Card Backdrop */}
          <svg
            class="absolute top-2 right-2 w-36 h-20 text-base-content pointer-events-none select-none overflow-visible opacity-30 group-hover:opacity-85 transition-opacity duration-500"
            viewBox="0 0 140 80"
            fill="none"
            aria-hidden="true"
          >
            {/* Constellation Filament Lines */}
            {constellation.lines.map(([i1, i2]) => {
              const p1 = constellation.stars[i1];
              const p2 = constellation.stars[i2];
              return (
                <line
                  x1={p1[0]}
                  y1={p1[1]}
                  x2={p2[0]}
                  y2={p2[1]}
                  stroke="currentColor"
                  stroke-width="0.75"
                  stroke-dasharray="2 2"
                  class="opacity-45 group-hover:opacity-90 transition-opacity duration-500"
                />
              );
            })}

            {/* Gravitational Ripple Wave around Principal Anchor Star */}
            <circle
              cx={anchorStar[0]}
              cy={anchorStar[1]}
              r="3"
              stroke="currentColor"
              stroke-width="0.6"
              class="sector-ripple opacity-0 group-hover:opacity-100"
            />

            {/* Constellation Stars (Monochromatic Real Starlight) */}
            {constellation.stars.map(([cx, cy], idx) => {
              const isAnchor = idx === constellation.anchorIndex;
              return (
                <circle
                  cx={cx}
                  cy={cy}
                  r={isAnchor ? "2.2" : "1.4"}
                  fill="currentColor"
                  class={isAnchor ? "opacity-95" : "opacity-60"}
                />
              );
            })}
          </svg>

          <div>
            {/* Card Header with Icon, Name, and Constellation Badge */}
            <div class="flex items-start justify-between gap-3 mb-4 relative z-10">
              <div class="flex items-start gap-3.5">
                <div class="p-3 bg-base-300/80 border border-base-content/10 text-primary rounded-xl flex items-center justify-center shrink-0 group-hover:scale-105 transition-all duration-300 shadow-xs">
                  <SkillIcon name={category.icon} class="w-6 h-6" />
                </div>
                <div class="space-y-1">
                  <h3 class="font-bold text-sm md:text-base text-base-content leading-tight group-hover:text-primary transition-colors duration-300">
                    {category.name}
                  </h3>
                  {category.description && (
                    <p class="text-xs text-base-content/80 leading-normal font-medium">
                      {category.description}
                    </p>
                  )}
                </div>
              </div>

              {/* Constellation Badge */}
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-base-300/60 border border-base-content/10 text-[10px] font-mono text-base-content/75 shrink-0 group-hover:border-primary/40 transition-colors">
                <span class="text-primary text-[10px] leading-none">✦</span>
                <span class="font-bold tracking-wider">
                  {constellation.latin}
                </span>
              </div>
            </div>

            {/* Authentic Astronomical Lore Connector Bar */}
            <div
              class="my-3 pt-2.5 border-t border-base-content/10 flex items-center justify-between gap-2 text-[11px] font-mono text-base-content/70 relative z-10 cursor-help"
              title={`${constellation.latin} (★ ${constellation.alpha}): ${constellation.history[lang] || constellation.history.en}`}
            >
              <span class="truncate text-base-content/85">
                <span class="opacity-50">//</span>{" "}
                {constellation.meaning[lang] || constellation.meaning.en}
              </span>
              <span class="text-[10px] opacity-65 shrink-0 font-medium">
                ★ {constellation.alpha}
              </span>
            </div>
          </div>

          {/* Skill Items Badges */}
          <div class="flex flex-wrap gap-2 mt-auto relative z-10">
            {category.items.map((item) => (
              <a
                href={`/${lang}/search/?q=${encodeURIComponent(item)}&evidence=1`}
                class="badge badge-xs font-mono bg-base-300/60 border border-base-content/10 text-base-content/85 hover:border-base-content/40 hover:text-primary transition-all duration-200 py-2 px-2.5"
              >
                {item}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .skill-card:target {
    border-color: var(--color-primary);
    outline: 1px solid var(--color-primary);
    outline-offset: 4px;
  }

  .skill-card:hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.45);
  }

  @keyframes sector-ripple-wave {
    0% {
      r: 3px;
      opacity: 0.75;
    }
    100% {
      r: 22px;
      opacity: 0;
    }
  }

  @keyframes sector-orbit-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .sector-orbit {
    transform-origin: center;
    transform-box: fill-box;
    animation: sector-orbit-spin 20s linear infinite;
  }

  .sector-ripple {
    opacity: 0.55;
    animation: sector-ripple-wave 3.2s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
  }

  .skill-card:hover .sector-ripple {
    opacity: 1;
    animation-duration: 1.8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-ripple,
    .sector-orbit {
      animation: none !important;
    }
  }
</style>
