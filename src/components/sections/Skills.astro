---
import { useTranslations, getSkillsForLang } from "../../i18n/utils";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillIcon from "../ui/SkillIcon.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);
const skillsCategories = getSkillsForLang(lang);

// Spectral astrophysical palette matching LagrangeSimulation.astro
const SPECTRAL_MAP: Record<
  string,
  { color: string; glow: string; coords: Array<[number, number]> }
> = {
  languages: {
    color: "#fbbf24", // Solar Corona Gold
    glow: "rgba(251, 191, 36, 0.14)",
    coords: [
      [28, 52],
      [58, 26],
      [88, 44],
      [114, 22],
    ],
  },
  frontend: {
    color: "#3b82f6", // Earth Azure
    glow: "rgba(59, 130, 246, 0.14)",
    coords: [
      [24, 38],
      [54, 18],
      [82, 48],
      [112, 28],
    ],
  },
  backend: {
    color: "#10b981", // Pulsar Emerald
    glow: "rgba(16, 185, 129, 0.14)",
    coords: [
      [26, 26],
      [62, 50],
      [92, 24],
      [118, 46],
    ],
  },
  databases: {
    color: "#f59e0b", // Accretion Amber
    glow: "rgba(245, 158, 11, 0.14)",
    coords: [
      [30, 48],
      [60, 22],
      [94, 38],
      [116, 18],
    ],
  },
  devops: {
    color: "#06b6d4", // Deep Space Cyan
    glow: "rgba(6, 182, 212, 0.14)",
    coords: [
      [24, 46],
      [58, 20],
      [88, 52],
      [114, 26],
    ],
  },
  security: {
    color: "#ec4899", // Supernova Rose
    glow: "rgba(236, 72, 153, 0.14)",
    coords: [
      [28, 28],
      [56, 52],
      [86, 22],
      [116, 40],
    ],
  },
  ai: {
    color: "#8b5cf6", // Nebula Violet
    glow: "rgba(139, 92, 246, 0.14)",
    coords: [
      [26, 44],
      [58, 18],
      [86, 42],
      [116, 20],
    ],
  },
  "soft-skills": {
    color: "#38bdf8", // Celestial Ice
    glow: "rgba(56, 189, 248, 0.14)",
    coords: [
      [30, 36],
      [62, 18],
      [92, 44],
      [118, 24],
    ],
  },
};
---

<section
  id="skills"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal relative"
>
  <SectionHeading subtitle={t("skills.subtitle")} title={t("skills.title")} />

  <!-- Celestial Constellation Sector Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {skillsCategories.map((category) => {
      const spec = SPECTRAL_MAP[category.id] || SPECTRAL_MAP.languages;
      const [p1, p2, p3, p4] = spec.coords;
      const pathD = `M ${p1[0]} ${p1[1]} L ${p2[0]} ${p2[1]} L ${p3[0]} ${p3[1]} L ${p4[0]} ${p4[1]}`;

      return (
        <div
          id={`skills-${category.id}`}
          tabindex={-1}
          data-spotlight="true"
          style={`--sector-color: ${spec.color}; --sector-glow: ${spec.glow};`}
          class="skill-card scroll-mt-24 group relative card bg-base-200/45 backdrop-blur-md border border-base-content/10 p-6 rounded-2xl transition-all duration-500 hover:border-[var(--sector-color)]/45 hover:-translate-y-1 overflow-hidden"
        >
          {/* Ambient Spectral Nebula Glow on Hover */}
          <div
            class="absolute -top-12 -right-12 w-44 h-44 rounded-full pointer-events-none opacity-35 group-hover:opacity-90 transition-opacity duration-500 blur-2xl"
            style={`background: radial-gradient(circle, var(--sector-glow) 0%, transparent 70%);`}
            aria-hidden="true"
          />

          {/* Living Constellation & Orbital SVG in Card Backdrop */}
          <svg
            class="absolute top-2 right-2 w-36 h-20 pointer-events-none select-none overflow-visible opacity-45 group-hover:opacity-95 transition-opacity duration-500"
            viewBox="0 0 140 75"
            fill="none"
            aria-hidden="true"
          >
            {/* Faint Orbital Arc */}
            <circle
              cx={p2[0]}
              cy={p2[1]}
              r="26"
              stroke={spec.color}
              stroke-width="0.5"
              stroke-dasharray="2 3"
              class="opacity-30 sector-orbit"
            />
            {/* Constellation Filament Lines */}
            <path
              d={pathD}
              stroke={spec.color}
              stroke-width="0.75"
              stroke-dasharray="2 2"
              class="opacity-45 group-hover:opacity-90 transition-opacity duration-500"
            />
            {/* Secondary Triangle Filament */}
            <line
              x1={p1[0]}
              y1={p1[1]}
              x2={p3[0]}
              y2={p3[1]}
              stroke={spec.color}
              stroke-width="0.4"
              class="opacity-20"
            />
            {/* Gravitational Ripple Wave around Principal Star (p2) */}
            <circle
              cx={p2[0]}
              cy={p2[1]}
              r="3"
              stroke={spec.color}
              stroke-width="0.6"
              class="sector-ripple opacity-0 group-hover:opacity-100"
            />
            {/* Constellation Stars */}
            {spec.coords.map(([cx, cy], idx) =>
              idx === 1 ? (
                /* Principal 4-Point Diamond Star */
                <path
                  d={`M${cx} ${cy - 4.5} C${cx} ${cy - 1} ${cx} ${cy - 1} ${cx + 4.5} ${cy} C${cx} ${cy} ${cx} ${cy + 1} ${cx} ${cy + 4.5} C${cx} ${cy + 1} ${cx} ${cy + 1} ${cx - 4.5} ${cy} C${cx} ${cy - 1} ${cx} ${cy - 1} ${cx} ${cy - 4.5} Z`}
                  fill={spec.color}
                />
              ) : (
                <circle
                  cx={cx}
                  cy={cy}
                  r={idx === 3 ? "2" : "1.5"}
                  fill={spec.color}
                  class="opacity-80"
                />
              ),
            )}
          </svg>

          {/* Card Header with Icon and Description */}
          <div class="flex items-start gap-4 mb-5 relative z-10">
            <div
              class="p-3 bg-base-300/80 border border-base-content/10 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-105 transition-all duration-300 shadow-xs"
              style={`color: ${spec.color};`}
            >
              <SkillIcon name={category.icon} class="w-6 h-6" />
            </div>
            <div class="space-y-1 pr-6">
              <h3 class="font-bold text-sm md:text-base text-base-content leading-tight group-hover:text-primary transition-colors duration-300">
                {category.name}
              </h3>
              {category.description && (
                <p class="text-xs text-base-content/80 leading-normal font-medium">
                  {category.description}
                </p>
              )}
            </div>
          </div>

          {/* Skill Items Badges */}
          <div class="flex flex-wrap gap-2 mt-auto relative z-10">
            {category.items.map((item) => (
              <a
                href={`/${lang}/search/?q=${encodeURIComponent(item)}&evidence=1`}
                class="badge badge-xs font-mono bg-base-300/60 border border-base-content/10 text-base-content/85 hover:border-[var(--sector-color)]/60 hover:text-primary transition-all duration-200 py-2 px-2.5"
              >
                {item}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .skill-card:target {
    border-color: var(--color-primary);
    outline: 1px solid var(--color-primary);
    outline-offset: 4px;
  }

  .skill-card:hover {
    box-shadow:
      0 20px 40px -15px rgba(0, 0, 0, 0.45),
      0 0 25px -5px var(--sector-glow);
  }

  @keyframes sector-ripple-wave {
    0% {
      r: 3px;
      opacity: 0.75;
    }
    100% {
      r: 22px;
      opacity: 0;
    }
  }

  @keyframes sector-orbit-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .sector-orbit {
    transform-origin: center;
    transform-box: fill-box;
    animation: sector-orbit-spin 20s linear infinite;
  }

  .sector-ripple {
    opacity: 0.55;
    animation: sector-ripple-wave 3.2s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
  }

  .skill-card:hover .sector-ripple {
    opacity: 1;
    animation-duration: 1.8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-ripple,
    .sector-orbit {
      animation: none !important;
    }
  }
</style>
