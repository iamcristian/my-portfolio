---
import { useTranslations, getSkillsForLang } from "../../i18n/utils";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillIcon from "../ui/SkillIcon.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);
const skillsCategories = getSkillsForLang(lang);

// Realistic monochromatic starlight constellation geometries per skill sector
const CONSTELLATION_COORDS: Record<string, Array<[number, number]>> = {
  languages: [
    [28, 52],
    [58, 26],
    [88, 44],
    [114, 22],
  ],
  frontend: [
    [24, 38],
    [54, 18],
    [82, 48],
    [112, 28],
  ],
  backend: [
    [26, 26],
    [62, 50],
    [92, 24],
    [118, 46],
  ],
  databases: [
    [30, 48],
    [60, 22],
    [94, 38],
    [116, 18],
  ],
  devops: [
    [24, 46],
    [58, 20],
    [88, 52],
    [114, 26],
  ],
  security: [
    [28, 28],
    [56, 52],
    [86, 22],
    [116, 40],
  ],
  ai: [
    [26, 44],
    [58, 18],
    [86, 42],
    [116, 20],
  ],
  "soft-skills": [
    [30, 36],
    [62, 18],
    [92, 44],
    [118, 24],
  ],
};
---

<section
  id="skills"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal relative"
>
  <SectionHeading subtitle={t("skills.subtitle")} title={t("skills.title")} />

  <!-- Monochromatic Celestial Constellation Sector Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {skillsCategories.map((category) => {
      const coords =
        CONSTELLATION_COORDS[category.id] || CONSTELLATION_COORDS.languages;
      const [p1, p2, p3, p4] = coords;
      const pathD = `M ${p1[0]} ${p1[1]} L ${p2[0]} ${p2[1]} L ${p3[0]} ${p3[1]} L ${p4[0]} ${p4[1]}`;

      return (
        <div
          id={`skills-${category.id}`}
          tabindex={-1}
          data-spotlight="true"
          class="skill-card scroll-mt-24 group relative card bg-base-200/45 backdrop-blur-md border border-base-content/10 p-6 rounded-2xl transition-all duration-500 hover:border-base-content/30 hover:-translate-y-1 overflow-hidden"
        >
          {/* Ambient Starlight Glow on Hover */}
          <div
            class="absolute -top-12 -right-12 w-44 h-44 rounded-full pointer-events-none opacity-20 group-hover:opacity-65 transition-opacity duration-500 blur-2xl bg-base-content/10"
            aria-hidden="true"
          />

          {/* Living Monochromatic Constellation & Orbital SVG in Card Backdrop */}
          <svg
            class="absolute top-2 right-2 w-36 h-20 text-base-content pointer-events-none select-none overflow-visible opacity-35 group-hover:opacity-75 transition-opacity duration-500"
            viewBox="0 0 140 75"
            fill="none"
            aria-hidden="true"
          >
            {/* Faint Orbital Arc */}
            <circle
              cx={p2[0]}
              cy={p2[1]}
              r="26"
              stroke="currentColor"
              stroke-width="0.5"
              stroke-dasharray="2 3"
              class="opacity-25 sector-orbit"
            />
            {/* Constellation Filament Lines */}
            <path
              d={pathD}
              stroke="currentColor"
              stroke-width="0.65"
              stroke-dasharray="2 2"
              class="opacity-40 group-hover:opacity-80 transition-opacity duration-500"
            />
            {/* Secondary Triangle Filament */}
            <line
              x1={p1[0]}
              y1={p1[1]}
              x2={p3[0]}
              y2={p3[1]}
              stroke="currentColor"
              stroke-width="0.4"
              class="opacity-20"
            />
            {/* Gravitational Ripple Wave around Principal Star (p2) */}
            <circle
              cx={p2[0]}
              cy={p2[1]}
              r="3"
              stroke="currentColor"
              stroke-width="0.6"
              class="sector-ripple opacity-0 group-hover:opacity-100"
            />
            {/* Constellation Stars (Monochromatic Starlight) */}
            {coords.map(([cx, cy], idx) => (
              <circle
                cx={cx}
                cy={cy}
                r={idx === 1 ? "2.1" : idx === 3 ? "1.6" : "1.3"}
                fill="currentColor"
                class={idx === 1 ? "opacity-95" : "opacity-65"}
              />
            ))}
          </svg>

          {/* Card Header with Icon and Description */}
          <div class="flex items-start gap-4 mb-5 relative z-10">
            <div class="p-3 bg-base-300/80 border border-base-content/10 text-primary rounded-xl flex items-center justify-center shrink-0 group-hover:scale-105 transition-all duration-300 shadow-xs">
              <SkillIcon name={category.icon} class="w-6 h-6" />
            </div>
            <div class="space-y-1 pr-6">
              <h3 class="font-bold text-sm md:text-base text-base-content leading-tight group-hover:text-primary transition-colors duration-300">
                {category.name}
              </h3>
              {category.description && (
                <p class="text-xs text-base-content/80 leading-normal font-medium">
                  {category.description}
                </p>
              )}
            </div>
          </div>

          {/* Skill Items Badges */}
          <div class="flex flex-wrap gap-2 mt-auto relative z-10">
            {category.items.map((item) => (
              <a
                href={`/${lang}/search/?q=${encodeURIComponent(item)}&evidence=1`}
                class="badge badge-xs font-mono bg-base-300/60 border border-base-content/10 text-base-content/85 hover:border-base-content/40 hover:text-primary transition-all duration-200 py-2 px-2.5"
              >
                {item}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .skill-card:target {
    border-color: var(--color-primary);
    outline: 1px solid var(--color-primary);
    outline-offset: 4px;
  }

  .skill-card:hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.45);
  }

  @keyframes sector-ripple-wave {
    0% {
      r: 3px;
      opacity: 0.75;
    }
    100% {
      r: 22px;
      opacity: 0;
    }
  }

  @keyframes sector-orbit-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .sector-orbit {
    transform-origin: center;
    transform-box: fill-box;
    animation: sector-orbit-spin 20s linear infinite;
  }

  .sector-ripple {
    opacity: 0.55;
    animation: sector-ripple-wave 3.2s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
  }

  .skill-card:hover .sector-ripple {
    opacity: 1;
    animation-duration: 1.8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-ripple,
    .sector-orbit {
      animation: none !important;
    }
  }
</style>
