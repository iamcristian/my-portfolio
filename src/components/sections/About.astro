---
import { useTranslations } from "../../i18n/utils";
import SectionHeading from "../ui/SectionHeading.astro";
import { Image } from "astro:assets";
import meImage from "../../assets/images/me.webp";
import { SITE } from "../../config/site";

const { lang } = Astro.locals;
const t = useTranslations(lang);
---

<section
  id="about"
  class="py-10 md:py-20 lg:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal relative"
>
  <!-- Technical watermark coordinates -->
  <div class="absolute top-6 right-8 font-mono text-[10px] tracking-widest text-base-content/20 select-none pointer-events-none hidden md:block">
    SYS.BIO.01 // CORE_PROFILE
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 items-center">
    <!-- Info Column -->
    <div class="md:col-span-2 space-y-5 md:space-y-6">
      <SectionHeading
        subtitle={t("about.subtitle")}
        title={t("about.title")}
        centered={false}
      />

      <div class="space-y-3 md:space-y-4 opacity-90 leading-relaxed text-xs md:text-sm">
        <p>{t("about.p1")}</p>
        <p>{t("about.p2")}</p>
        <p>{t("about.p3")}</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="badge badge-outline text-xs">{t("about.location")}</span>
      </div>

      <!-- Systems Telemetry Header & Bento Metrics -->
      <div class="space-y-3 mt-4 md:mt-6">
        <div class="flex items-center justify-between border-b border-base-content/10 pb-2.5 font-mono text-[11px] tracking-wider uppercase opacity-80">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            <span class="text-primary font-semibold">
              SYS.TELEMETRY // LIVE METRICS
            </span>
          </div>
          <div class="flex items-center gap-2 text-success text-[10px]">
            <span class="w-1.5 h-1.5 rounded-full bg-success animate-ping"></span>
            <span>OPERATIONAL</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full">
          <!-- Metric 1: Experience -->
          <div
            data-spotlight="true"
            class="card bg-base-200 border border-base-300 p-4 rounded-xl flex flex-col justify-between hover:border-primary/40 transition-all duration-300 relative group/metric"
          >
            <div class="flex items-center justify-between font-mono text-[10px] text-base-content/60 mb-2">
              <span>TRAJECTORY</span>
              <span class="text-primary font-bold">01</span>
            </div>
            <div class="stat-value text-primary text-2xl lg:text-3xl font-extrabold tracking-tight">
              <span class="stat-counter" data-target="1" data-suffix="+">
                {t("about.expValue")}
              </span>
            </div>
            <div class="stat-title text-base-content/80 text-xs mt-1 leading-tight font-medium">
              {t("about.expTitle")}
            </div>
            <div class="w-full h-1 bg-base-300 rounded-full mt-3 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-primary to-accent w-4/5 rounded-full"></div>
            </div>
          </div>

          <!-- Metric 2: Passion & Rigor -->
          <div
            data-spotlight="true"
            class="card bg-base-200 border border-base-300 p-4 rounded-xl flex flex-col justify-between hover:border-secondary/40 transition-all duration-300 relative group/metric"
          >
            <div class="flex items-center justify-between font-mono text-[10px] text-base-content/60 mb-2">
              <span>EFFICIENCY</span>
              <span class="text-secondary font-bold">02</span>
            </div>
            <div class="stat-value text-secondary text-2xl lg:text-3xl font-extrabold tracking-tight">
              <span class="stat-counter" data-target="100" data-suffix="%">
                {t("about.passionValue")}
              </span>
            </div>
            <div class="stat-title text-base-content/80 text-xs mt-1 leading-tight font-medium">
              {t("about.passionTitle")}
            </div>
            <div class="w-full h-1 bg-base-300 rounded-full mt-3 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-secondary to-primary w-full rounded-full"></div>
            </div>
          </div>

          <!-- Metric 3: Strategic Thinking -->
          <div
            data-spotlight="true"
            class="card bg-base-200 border border-base-300 p-4 rounded-xl flex flex-col justify-between hover:border-accent/40 transition-all duration-300 relative group/metric"
          >
            <div class="flex items-center justify-between font-mono text-[10px] text-base-content/60 mb-2">
              <span>ARCHITECTURE</span>
              <span class="text-accent font-bold">03</span>
            </div>
            <div class="stat-value text-accent text-2xl lg:text-3xl font-extrabold tracking-tight">
              <span>{t("about.stratValue")}</span>
            </div>
            <div class="stat-title text-base-content/80 text-xs mt-1 leading-tight font-medium">
              {t("about.stratTitle")}
            </div>
            <div class="w-full h-1 bg-base-300 rounded-full mt-3 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-accent via-primary to-accent w-full rounded-full animate-pulse"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Photo Column -->
    <div class="flex justify-center mt-4 md:mt-0">
      <div
        data-tilt="true"
        data-spotlight="true"
        class="relative p-2 rounded-3xl transition-transform duration-300 group/avatar"
      >
        <div class="absolute -inset-2 sm:-inset-4 rounded-2xl border border-base-content/10 opacity-60"></div>
        <div class="absolute -inset-4 sm:-inset-8 rounded-3xl border border-base-content/5 opacity-40"></div>

        <div class="relative w-44 h-44 sm:w-56 sm:h-56 lg:w-72 lg:h-72 rounded-2xl overflow-hidden shadow-2xl border border-base-300 bg-base-300">
          <Image
            src={meImage}
            alt={SITE.name}
            width={300}
            height={300}
            class="w-full h-full object-cover group-hover/avatar:scale-105 transition-transform duration-500"
          />
        </div>

        <div class="absolute -bottom-1 sm:-bottom-2 -right-1 sm:-right-2 w-6 h-6 border-b-2 border-r-2 border-primary rounded-br-lg"></div>
        <div class="absolute -top-1 sm:-top-2 -left-1 sm:-left-2 w-6 h-6 border-t-2 border-l-2 border-primary rounded-tl-lg"></div>
      </div>
    </div>
  </div>
</section>
