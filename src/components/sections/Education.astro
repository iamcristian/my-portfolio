---
import {
  useTranslations,
  getEducationForLang,
  getCertificationsForLang,
  getLanguagesForLang,
} from "../../i18n/utils";
import SectionHeading from "../ui/SectionHeading.astro";
import AcademicCard from "../ui/cards/AcademicCard.astro";
import CertificationCard from "../ui/cards/CertificationCard.astro";
import LanguageCard from "../ui/cards/LanguageCard.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

const academicEducation = getEducationForLang(lang);
const certifications = getCertificationsForLang(lang);
const localizedLanguages = getLanguagesForLang(lang);
---

<section
  id="education"
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 scroll-reveal"
>
  <SectionHeading
    subtitle={t("education.subtitle")}
    title={t("education.title")}
  />

  <!-- Main Radio-based CSS Tabs (Bordered for a cleaner, modern look) -->
  <div class="tabs tabs-bordered justify-center w-full">
    <!-- TAB 1: Academic Background -->
    <input
      type="radio"
      name="edu_tabs"
      class="tab text-sm font-semibold text-nowrap"
      aria-label={t("education.tabAcademic")}
      checked="checked"
    />
    <div class="tab-content bg-base-100/30 border-base-300 rounded-b-2xl p-6 space-y-6 mt-4">
      {academicEducation.map((item) => (
        <AcademicCard item={item} />
      ))}
    </div>

    <!-- TAB 2: Certifications -->
    <input
      type="radio"
      name="edu_tabs"
      class="tab text-sm font-semibold text-nowrap"
      aria-label={t("education.tabCerts")}
    />
    <div class="tab-content bg-base-100/30 border-base-300 rounded-b-2xl p-6 space-y-6 max-h-150 overflow-y-auto mt-4">
      <!-- Category Filter Pills -->
      <div
        id="cert-category-filters"
        class="flex flex-wrap gap-2 pb-2"
        role="group"
        aria-label={t("education.tabCerts")}
      >
        <button
          type="button"
          class="btn btn-xs sm:btn-sm btn-primary cert-cat-btn"
          aria-pressed="true"
          data-category="all"
        >
          {t("education.certsAll")}
        </button>
        {certifications.map((category) => (
          <button
            type="button"
            class="btn btn-xs sm:btn-sm btn-outline cert-cat-btn"
            aria-pressed="false"
            data-category={category.id}
          >
            {category.name}
          </button>
        ))}
      </div>

      {certifications.map((category) => (
        <section data-cert-category={category.id} class="space-y-4">
          <h3 class="font-bold text-xs uppercase tracking-wider border-b border-base-300 pb-2">
            {category.name}
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {category.items.map((item) => (
              <CertificationCard item={item} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- TAB 3: Languages -->
    <input
      type="radio"
      name="edu_tabs"
      class="tab text-sm font-semibold text-nowrap"
      aria-label={t("education.tabLanguages")}
    />
    <div class="tab-content bg-base-100/30 border-base-300 rounded-b-2xl p-6 mt-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        {localizedLanguages.map((item) => (
          <LanguageCard item={item} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "#cert-category-filters .cert-cat-btn",
    );
    const groups = document.querySelectorAll<HTMLElement>(
      "[data-cert-category]",
    );
    buttons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          const selected = btn.dataset.category || "all";
          buttons.forEach((b) => {
            const active = b === btn;
            b.setAttribute("aria-pressed", String(active));
            b.classList.toggle("btn-primary", active);
            b.classList.toggle("btn-outline", !active);
          });
          groups.forEach((group) => {
            group.hidden =
              selected !== "all" && group.dataset.certCategory !== selected;
          });
        },
        { signal },
      );
    });
  });
</script>
