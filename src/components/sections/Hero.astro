---
import { useTranslations } from "../../i18n/utils";
import { SITE } from "../../config/site";
import SocialLinks from "../ui/SocialLinks.astro";
import DownloadIcon from "../../assets/icons/download.svg";
import MailIcon from "../../assets/icons/mail.svg";
import LagrangeSimulation from "../ui/LagrangeSimulation.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

const cvPath = SITE.cv[lang] || SITE.cv.en;

// Deterministic pseudo-random number generator (Mulberry32) for reproducible, stable starfields
const createPrng = (seed: number) => {
  let s = seed | 0;
  return () => {
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

const generateDeterministicShadows = (
  count: number,
  seed: number,
  withGlow = false,
) => {
  const prng = createPrng(seed);
  const shadows: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = (prng() * 99).toFixed(2);
    // Keep stars well within the Hero fold (0vh to 92vh)
    const y = (prng() * 92).toFixed(2);
    const opacity = (0.7 + prng() * 0.3).toFixed(2);
    const isCoolWhite = prng() > 0.4;
    const color = isCoolWhite
      ? `rgba(224, 242, 254, ${opacity})`
      : `rgba(255, 255, 255, ${opacity})`;

    // Solid star core
    shadows.push(`${x}vw ${y}vh ${color}`);

    // If luminous foreground star, add a soft radiant halo
    if (withGlow) {
      const haloColor = isCoolWhite
        ? `rgba(186, 230, 253, 0.75)`
        : `rgba(254, 240, 138, 0.75)`;
      shadows.push(`${x}vw ${y}vh 3px ${haloColor}`);
    }
  }
  return shadows.join(", ");
};

// 3 depth layers of stars with generous densities and crisp brightness
const starsLayer1Shadow = generateDeterministicShadows(85, 1337);
const starsLayer2Shadow = generateDeterministicShadows(55, 2026);
const starsLayer3Shadow = generateDeterministicShadows(25, 777, true);
---

<section
  id="home"
  class="hero min-h-[calc(100vh-4rem)] bg-base-100 relative overflow-hidden group/hero"
  style="--mouse-x: 50%; --mouse-y: 50%;"
>
  <!-- Ambient Cosmic Nebula Glows -->
  <div class="absolute top-1/4 left-1/4 w-100 h-100 rounded-full bg-primary/10 blur-[110px] pointer-events-none nebula-glow-1"></div>
  <div class="absolute bottom-1/4 right-1/4 w-130 h-130 rounded-full bg-secondary/8 blur-[130px] pointer-events-none nebula-glow-2"></div>

  <!-- Interactive Cosmic Nebula Spotlight (Follows mouse) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-0 group-hover/hero:opacity-100 transition-opacity duration-700"
    style="background: radial-gradient(850px circle at var(--mouse-x) var(--mouse-y), color-mix(in oklch, var(--color-primary) 12%, transparent) 0%, color-mix(in oklch, var(--color-secondary) 4%, transparent) 45%, transparent 75%);"
  ></div>

  <!-- Celestial Coordinate Chart (Astronomical Graticule) -->
  <div class="absolute inset-0 pointer-events-none celestial-chart overflow-hidden flex items-center justify-end pr-[5%] opacity-[0.05]">
    <svg
      class="w-212.5 h-212.5 text-base-content shrink-0"
      viewBox="0 0 800 800"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
    >
      <!-- Concentric Declination Circles -->
      <circle cx="400" cy="400" r="120" stroke-dasharray="3 6"></circle>
      <circle cx="400" cy="400" r="230" stroke-dasharray="2 4"></circle>
      <circle cx="400" cy="400" r="340"></circle>
      <circle cx="400" cy="400" r="390" stroke-dasharray="4 8"></circle>

      <!-- Right Ascension Radial Axes -->
      <line x1="10" y1="400" x2="790" y2="400" stroke-dasharray="4 6"></line>
      <line x1="400" y1="10" x2="400" y2="790" stroke-dasharray="4 6"></line>
      <line x1="124" y1="124" x2="676" y2="676" stroke-dasharray="2 8"></line>
      <line x1="124" y1="676" x2="676" y2="124" stroke-dasharray="2 8"></line>

      <!-- Celestial Calibration Marks -->
      <path
        d="M 390 400 L 410 400 M 400 390 L 400 410"
        stroke-width="1.5"
      ></path>
      <path d="M 620 400 L 640 400 M 630 390 L 630 410"></path>
      <path d="M 160 400 L 180 400 M 170 390 L 170 410"></path>
      <path d="M 400 620 L 400 640 M 390 630 L 410 630"></path>
      <path d="M 400 160 L 400 180 M 390 170 L 410 170"></path>
    </svg>
  </div>

  <!-- Stars Backdrop with 3D Depth Parallax -->
  <div class="absolute inset-0 pointer-events-none stars-container overflow-hidden">
    <div
      class="stars-layer stars-layer-1"
      style={`box-shadow: ${starsLayer1Shadow};`}
    ></div>
    <div
      class="stars-layer stars-layer-2"
      style={`box-shadow: ${starsLayer2Shadow};`}
    ></div>
    <div
      class="stars-layer stars-layer-3"
      style={`box-shadow: ${starsLayer3Shadow};`}
    ></div>

    <!-- Sparkling 4-Point Constellation Stars -->
    <svg class="sparkle-star sparkle-1" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z" />
    </svg>
    <svg class="sparkle-star sparkle-2" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z" />
    </svg>
    <svg class="sparkle-star sparkle-3" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z" />
    </svg>
    <svg class="sparkle-star sparkle-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z" />
    </svg>
    <svg class="sparkle-star sparkle-5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0 C12 7 12 7 19 12 C12 12 12 17 12 24 C12 17 12 17 5 12 C12 12 12 7 12 0 Z" />
    </svg>
  </div>

  <!-- Realistic Comets & Shooting Stars with Luminous Core and Tail -->
  <div class="shooting-star-track shooting-star-1">
    <div class="shooting-star-body">
      <span class="shooting-star-core"></span>
      <span class="shooting-star-tail"></span>
    </div>
  </div>
  <div class="shooting-star-track shooting-star-2">
    <div class="shooting-star-body">
      <span class="shooting-star-core"></span>
      <span class="shooting-star-tail"></span>
    </div>
  </div>
  <div class="shooting-star-track shooting-star-3">
    <div class="shooting-star-body">
      <span class="shooting-star-core"></span>
      <span class="shooting-star-tail"></span>
    </div>
  </div>

  <div class="hero-content flex-col lg:flex-row gap-12 lg:gap-16 max-w-6xl w-full justify-between px-4 md:px-8 mx-auto z-10">
    <!-- Left Column: Text & CTAs -->
    <div class="flex flex-col gap-6 text-center lg:text-left max-w-xl w-full">
      <div>
        <div class="inline-flex items-center gap-2 mb-3 justify-center lg:justify-start">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/80 animate-pulse"></span>
          <span class="font-mono text-xs tracking-widest uppercase text-primary font-semibold block">
            {t("home.hello")}
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight drop-shadow-sm">
          <span class="inline-block bg-linear-to-r from-primary via-neutral-content to-secondary bg-clip-text text-transparent drop-shadow-[0_0_10px_color-mix(in_oklch,var(--color-primary)_20%,transparent)]">
            {t("home.name")}
          </span>
        </h1>
      </div>
      <h2 class="text-xl lg:text-2xl font-semibold opacity-90">
        {t("home.subtitle")}
      </h2>
      <p class="text-xs md:text-sm lg:text-base opacity-75 leading-relaxed lg:border-l-2 lg:border-primary/20 lg:pl-4 lg:py-1">
        {t("home.tagline")}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4 justify-center lg:justify-start mt-4">
        <a
          href={cvPath}
          class="btn btn-primary gap-2 transition-all duration-300 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 hover:shadow-[0_0_20px_color-mix(in_oklch,var(--color-primary)_30%,transparent)]"
          target="_blank"
        >
          <DownloadIcon class="w-5 h-5" />
          <span>{t("home.downloadCv")}</span>
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="btn btn-outline gap-2 transition-all duration-300 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 hover:bg-base-content/10 hover:border-primary/40"
        >
          <MailIcon class="w-5 h-5" />
          <span>{t("home.contactMe")}</span>
        </a>
      </div>

      <!-- Social Links -->
      <SocialLinks class="justify-center lg:justify-start mt-2" />
    </div>

    <!-- Right Column: Lagrange Star Chart Card with Cosmic Gravitational Lens Frame -->
    <div class="hidden md:flex justify-center items-center relative w-115 h-127.5 group/gravitational">
      <!-- Deep Cosmic Accretion Glow (Lens effect behind card) -->
      <div class="absolute -inset-10 rounded-full bg-radial from-primary/12 via-secondary/6 to-transparent blur-[60px] pointer-events-none gravitational-aura"></div>

      <!-- Gravitational Curvature Orbit Rings -->
      <div class="absolute -inset-5 rounded-full border border-primary/15 pointer-events-none gravitational-ring-1"></div>
      <div class="absolute -inset-12 rounded-full border border-secondary/10 pointer-events-none gravitational-ring-2"></div>

      <!-- Untouched Original Lagrange Simulation Component -->
      <LagrangeSimulation class="w-full h-full flex justify-center items-center relative" />
    </div>
  </div>
</section>

<style>
  /* Keyframes for Cosmic floating elements */
  @keyframes float-nebula {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(18px, -18px) scale(1.05);
    }
  }

  .nebula-glow-1 {
    animation: float-nebula 16s ease-in-out infinite;
    will-change: transform;
  }
  .nebula-glow-2 {
    animation: float-nebula 24s ease-in-out infinite reverse;
    will-change: transform;
  }

  /* Gravitational Lens Aura & Rings */
  @keyframes gravitational-pulse {
    0%,
    100% {
      transform: scale(0.95);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.06);
      opacity: 0.85;
    }
  }

  @keyframes gravitational-rotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .gravitational-aura {
    animation: gravitational-pulse 9s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .gravitational-ring-1 {
    animation: gravitational-rotate 55s linear infinite;
    border-style: dashed;
    border-dasharray: 6 12;
  }

  .gravitational-ring-2 {
    animation: gravitational-rotate 85s linear infinite reverse;
    border-style: dashed;
    border-dasharray: 3 9;
  }

  /* Realistic Shooting Stars / Comets */
  .shooting-star-track {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
  }

  .shooting-star-body {
    display: flex;
    align-items: center;
    position: relative;
  }

  .shooting-star-core {
    width: 3.5px;
    height: 3.5px;
    background: #ffffff;
    border-radius: 9999px;
    box-shadow:
      0 0 6px #ffffff,
      0 0 14px var(--color-primary);
    flex-shrink: 0;
  }

  .shooting-star-tail {
    height: 1.5px;
    width: 120px;
    background: linear-gradient(
      to left,
      transparent,
      color-mix(in oklch, var(--color-primary) 70%, transparent),
      #ffffff
    );
    opacity: 0.9;
    border-radius: 9999px;
  }

  .shooting-star-1 {
    top: 14%;
    right: 22%;
    animation: shooting-star-realistic 9s cubic-bezier(0.25, 0.1, 0.25, 1)
      infinite 2.5s;
  }
  .shooting-star-2 {
    top: 32%;
    right: 48%;
    animation: shooting-star-realistic 14s cubic-bezier(0.25, 0.1, 0.25, 1)
      infinite 7s;
  }
  .shooting-star-3 {
    top: 50%;
    right: 15%;
    animation: shooting-star-realistic 19s cubic-bezier(0.25, 0.1, 0.25, 1)
      infinite 12s;
  }

  @keyframes shooting-star-realistic {
    0% {
      transform: translate3d(140px, -140px, 0) rotate(-45deg) scale(0.2);
      opacity: 0;
    }
    4% {
      opacity: 1;
      transform: translate3d(70px, -70px, 0) rotate(-45deg) scale(1.15);
    }
    12% {
      transform: translate3d(-190px, 190px, 0) rotate(-45deg) scale(0.5);
      opacity: 0;
    }
    100% {
      transform: translate3d(-190px, 190px, 0) rotate(-45deg) scale(0);
      opacity: 0;
    }
  }

  /* Cosmic Stars Backdrop Layers */
  .stars-layer {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 9999px;
    background: transparent;
    backface-visibility: hidden;
  }

  .stars-layer-1 {
    width: 2px;
    height: 2px;
    animation: twinkle-1 6s ease-in-out infinite;
  }

  .stars-layer-2 {
    width: 2.75px;
    height: 2.75px;
    animation: twinkle-2 9s ease-in-out infinite;
  }

  .stars-layer-3 {
    width: 4px;
    height: 4px;
    animation: twinkle-3 12s ease-in-out infinite;
  }

  .celestial-chart {
    /* Fixed astronomical graticule background */
  }

  /* 4-Point Sparkling Diamond Stars */
  .sparkle-star {
    position: absolute;
    color: #ffffff;
    filter: drop-shadow(0 0 4px var(--color-primary))
      drop-shadow(0 0 8px #ffffff);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .sparkle-1 {
    top: 18%;
    left: 14%;
    width: 14px;
    height: 14px;
    animation: sparkle-pulse 5s ease-in-out infinite;
  }
  .sparkle-2 {
    top: 24%;
    left: 48%;
    width: 10px;
    height: 10px;
    animation: sparkle-pulse 7s ease-in-out infinite 1.5s;
  }
  .sparkle-3 {
    top: 68%;
    left: 22%;
    width: 12px;
    height: 12px;
    animation: sparkle-pulse 6s ease-in-out infinite 3s;
  }
  .sparkle-4 {
    top: 15%;
    right: 18%;
    width: 13px;
    height: 13px;
    animation: sparkle-pulse 8s ease-in-out infinite 0.7s;
  }
  .sparkle-5 {
    top: 76%;
    right: 28%;
    width: 11px;
    height: 11px;
    animation: sparkle-pulse 6.5s ease-in-out infinite 2.2s;
  }

  @keyframes sparkle-pulse {
    0%,
    100% {
      transform: scale(0.65) rotate(0deg);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.15) rotate(15deg);
      opacity: 0.95;
    }
  }

  @keyframes twinkle-1 {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes twinkle-2 {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.65;
    }
  }
  @keyframes twinkle-3 {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .stars-layer,
    .sparkle-star,
    .celestial-chart,
    .gravitational-aura,
    .gravitational-ring-1,
    .gravitational-ring-2,
    .shooting-star-track,
    .nebula-glow-1,
    .nebula-glow-2 {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  let heroCleanup: (() => void) | null = null;

  function initCosmicHero() {
    heroCleanup?.();
    const hero = document.getElementById("home");
    if (!hero) return;

    // Set initial mouse values centered for the ambient spotlight
    hero.style.setProperty("--mouse-x", "50%");
    hero.style.setProperty("--mouse-y", "50%");

    const controller = new AbortController();
    const signal = controller.signal;

    let ticking = false;
    let frame = 0;

    hero.addEventListener(
      "mousemove",
      (e) => {
        if (!ticking) {
          frame = window.requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            hero.style.setProperty("--mouse-x", `${x}px`);
            hero.style.setProperty("--mouse-y", `${y}px`);
            ticking = false;
          });
          ticking = true;
        }
      },
      { signal },
    );

    hero.addEventListener(
      "mouseleave",
      () => {
        hero.style.setProperty("--mouse-x", "50%");
        hero.style.setProperty("--mouse-y", "50%");
      },
      { signal },
    );

    heroCleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
    };
  }

  // Initialize on load and on Astro page swaps
  document.addEventListener("astro:page-load", initCosmicHero);
  document.addEventListener("astro:before-swap", () => {
    heroCleanup?.();
    heroCleanup = null;
  });
</script>
