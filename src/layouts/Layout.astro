---
import "@assets/app.css";
import themeUrl from "../scripts/theme.js?url";
import SEO from "@components/SEO.astro";
import StructuredData from "@components/StructuredData.astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import { useTranslations, getLang } from "@i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  structuredDataType?: "profile" | "collection";
  wordCount?: number;
  noindex?: boolean;
  author?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="preload">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Web App Manifest & Mobile optimization -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#181818" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <SEO {...Astro.props} />
    {!Astro.props.noindex && <StructuredData {...Astro.props} />}
    <ClientRouter />

    <script is:inline src={themeUrl}></script>
    <script>
      import "../scripts/site";
    </script>
    <Analytics />
  </head>
  <body
    data-copy-code={t("accessibility.copyCode")}
    data-copied={t("blog.shareCopied")}
    data-copy-failed={t("accessibility.copyFailed")}
  >
    <p id="site-status" class="sr-only" role="status" aria-live="polite"></p>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 btn btn-primary border border-base-content/10 shadow-lg cursor-pointer"
    >
      {t("accessibility.skipToContent") || "Skip to main content"}
    </a>
    <slot />
  </body>
</html>
